      "publisher": { "@id": "https://steelgratingcalculator.com/#organization" }
    }
  }))
})} />

<script>
  // Hero inline weight calculator
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  function heroCalc() {
    const H = parseFloat((document.getElementById('h-bb-height') as HTMLSelectElement).value);
    const T = parseFloat((document.getElementById('h-bb-thick') as HTMLSelectElement).value);
    const P_bb = parseFloat((document.getElementById('h-bb-pitch') as HTMLSelectElement).value);
    const xbType = (document.getElementById('h-xb-type') as HTMLSelectElement).value;
    const d_xb = parseFloat((document.getElementById('h-xb-size') as HTMLSelectElement).value);
    const P_xb = parseFloat((document.getElementById('h-xb-pitch') as HTMLSelectElement).value);
    const rho = parseFloat((document.getElementById('h-material') as HTMLSelectElement).value);
    const qty = parseInt((document.getElementById('h-qty') as HTMLInputElement).value) || 1;

    const w_bb = (H * T * rho) / P_bb;
    const w_xb = xbType === 'round'
      ? (Math.PI / 4 * d_xb * d_xb * rho) / P_xb
      : (d_xb * d_xb * rho) / P_xb;
    const w_total = w_bb + w_xb;
    const w_panel = w_total * 6.0 * 1.0; // 6000×1000mm default
    const w_order = w_panel * qty;

    const m2El = document.getElementById('h-result-m2');
    const panelEl = document.getElementById('h-result-panel');
    const totalEl = document.getElementById('h-result-total');
    if (m2El) m2El.textContent = w_total.toFixed(2) + ' kg/m²';
    if (panelEl) panelEl.textContent = w_panel.toFixed(1) + ' kg';
    if (totalEl) totalEl.textContent = w_order >= 1000
      ? (w_order / 1000).toFixed(2) + ' t'
      : w_order.toFixed(0) + ' kg';
  }

  document.querySelectorAll('#h-bb-height,#h-bb-thick,#h-bb-pitch,#h-xb-type,#h-xb-size,#h-xb-pitch,#h-material,#h-qty')
    .forEach(el => el.addEventListener('change', heroCalc));
  document.getElementById('h-qty')?.addEventListener('input', heroCalc);
  heroCalc();
</script>
