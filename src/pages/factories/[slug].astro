---
import Base from "../../layouts/Base.astro";
import factoriesJson from "../../data/factories.json";
import { CATEGORIES } from "../../data/categories";

interface Factory {
  slug: string;
  name: string;
  nameZh?: string;
  tier: "listed" | "verified";
  categories: string[];
  city: string;
  province: string;
  website?: string;
  description: string;
  descriptionZh?: string;
  contact?: { email?: string; phone?: string; whatsapp?: string };
  founded?: number;
  employees?: string;
  exportMarkets?: string[];
  certifications?: string[];
  verifiedNote?: string;
}

export function getStaticPaths() {
  const data = factoriesJson as unknown as Factory[];
  return data.map((factory) => ({
    params: { slug: factory.slug },
    props: {
      factory,
      forceTranslation: {
        en: `/factories/${factory.slug}/`,
        zh: `/zh/factories/${factory.slug}/`,
      },
    },
  }));
}

const { factory, forceTranslation } = Astro.props;
const origin = Astro.site?.origin ?? "https://steelgratingcalculator.com";
const lang = "en";

const labelFor = (key: string) => CATEGORIES.find((c) => c.key === key)?.en ?? key;
const productLinkFor = (key: string) => CATEGORIES.find((c) => c.key === key)?.productEn ?? "/products/";
const primaryCategory = factory.categories[0];
const inquiryUrl = `/inquiry/?factory=${factory.slug}${primaryCategory ? `&category=${primaryCategory}` : ""}`;

const orgJson = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: factory.name,
  url: `${origin}/factories/${factory.slug}/`,
  ...(factory.website ? { sameAs: factory.website } : {}),
  description: factory.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: factory.city,
    addressRegion: factory.province,
    addressCountry: "CN",
  },
  ...(factory.founded ? { foundingDate: String(factory.founded) } : {}),
  ...(factory.certifications?.length ? { knowsAbout: factory.certifications } : {}),
};

const infoRows: [string, string][] = [
  ["Location", `${factory.city}, ${factory.province}, China`],
  ...(factory.founded ? [["Founded", String(factory.founded)] as [string, string]] : []),
  ...(factory.employees ? [["Employees", factory.employees] as [string, string]] : []),
  ...(factory.exportMarkets?.length ? [["Export markets", factory.exportMarkets.join(", ")] as [string, string]] : []),
  ...(factory.certifications?.length ? [["Certifications", factory.certifications.join(", ")] as [string, string]] : []),
];
---
<Base
  title={`${factory.name} — Anping Wire Mesh Factory`}
  description={factory.description}
  {lang}
  forceTranslation={forceTranslation}
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-theme-secondary mb-6">
      <a href="/" class="hover:text-theme-primary">Home</a>
      <span class="mx-2">›</span>
      <a href="/factories/" class="hover:text-theme-primary">Factories</a>
      <span class="mx-2">›</span>
      <span>{factory.name}</span>
    </nav>

    <div class="flex items-start gap-3 flex-wrap">
      <h1 class="text-3xl md:text-4xl font-bold text-theme-primary">{factory.name}</h1>
      {factory.tier === "verified" && (
        <span class="mt-2 shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full accent-bg on-accent">Verified</span>
      )}
    </div>
    {factory.nameZh && <p class="text-theme-muted mt-1">{factory.nameZh}</p>}

    <p class="text-theme-secondary text-lg mt-4 leading-relaxed">{factory.description}</p>

    <div class="mt-6 bg-theme-card border border-theme rounded-xl p-6">
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
        {infoRows.map(([k, v]) => (
          <div class="flex justify-between gap-4 border-b border-theme pb-2">
            <span class="text-theme-muted">{k}</span>
            <span class="text-theme-primary text-right">{v}</span>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-2 mt-4">
        {factory.categories.map((c) => (
          <a href={`/factories/?category=${c}`} class="text-xs px-2 py-0.5 rounded-full bg-theme-secondary border border-theme text-theme-secondary hover:text-theme-primary transition-colors">{labelFor(c)}</a>
        ))}
      </div>
    </div>

    {factory.tier === "verified" && factory.contact && (
      <div class="mt-6 bg-theme-card border border-accent rounded-xl p-6">
        <p class="font-bold text-theme-primary mb-1">Verified contact <span class="accent-text">✓</span></p>
        {factory.verifiedNote && <p class="text-xs text-theme-muted mb-4">{factory.verifiedNote}</p>}
        <ul class="space-y-2 text-sm">
          {factory.contact.email && (
            <li class="flex justify-between gap-4"><span class="text-theme-muted">Email</span><a href={`mailto:${factory.contact.email}`} class="text-theme-primary underline hover:text-theme-accent">{factory.contact.email}</a></li>
          )}
          {factory.contact.phone && (
            <li class="flex justify-between gap-4"><span class="text-theme-muted">Phone</span><a href={`tel:${factory.contact.phone.replace(/\s/g, "")}`} class="text-theme-primary underline">{factory.contact.phone}</a></li>
          )}
          {factory.contact.whatsapp && (
            <li class="flex justify-between gap-4"><span class="text-theme-muted">WhatsApp</span><a href={`https://wa.me/${factory.contact.whatsapp.replace(/[^\d]/g, "")}`} class="text-theme-primary underline">+{factory.contact.whatsapp.replace(/[^\d]/g, "")}</a></li>
          )}
        </ul>
      </div>
    )}

    {factory.tier === "listed" && (
      <p class="mt-6 text-sm text-theme-muted bg-theme-secondary bg-opacity-10 border border-theme rounded-lg p-4">
        This is a free <strong class="text-theme-secondary">Listed</strong> profile — contact details are not published.
        Send an inquiry below and it goes directly to this factory.
      </p>
    )}

    <div class="mt-8 bg-theme-secondary bg-opacity-10 border border-theme rounded-lg p-8 text-center">
      <p class="text-2xl font-bold text-theme-primary mb-4">Contact {factory.name}</p>
      <p class="text-theme-secondary mb-6 max-w-2xl mx-auto">
        Send your specification once — {factory.name} replies to you directly, with weights and coatings in writing. Free, responses within 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={inquiryUrl} class="inline-block px-8 py-3 accent-bg font-semibold rounded-lg hover:opacity-90 transition on-accent">
          Send an Inquiry
        </a>
        {factory.website && (
          <a href={`/go/${factory.slug}/`} class="inline-block px-8 py-3 bg-theme-card border border-theme text-theme-primary font-semibold rounded-lg hover:bg-theme transition">
            Visit Official Website ↗
          </a>
        )}
      </div>
      {factory.website && <p class="text-xs text-theme-muted mt-3">Official website link is click-tracked so we can prove value to listed factories.</p>}
    </div>

    <p class="mt-6 text-xs text-theme-muted">
      MeshCalculator lists factories but does not certify products or guarantee transactions. Verify suppliers independently before paying —
      see <a href="/blog/how-to-verify-china-wire-mesh-factory/" class="underline hover:text-theme-primary">how to verify a factory</a>.
    </p>

    <script type="application/ld+json" set:html={JSON.stringify(orgJson)} />
  </div>
</Base>
