---
import Base from "../../layouts/Base.astro";
import factoriesJson from "../../data/factories.json";

// 目录详情页以 /zh/inquiry/?factory=<slug>&category=<key> 链接过来
// 静态站点：预填在浏览器端用下方内嵌映射完成
const factoryNames: Record<string, string> = Object.fromEntries(
  (factoriesJson as { slug: string; name: string }[]).map((f) => [f.slug, f.name])
);
const categoryToProduct: Record<string, string> = {
  "stainless-steel-wire-mesh": "不锈钢编织网",
  "welded-wire-mesh": "焊接丝网 / 网片",
  "chain-link-fence": "护栏系统",
  "wire-mesh-fence-panels": "护栏系统",
  "gabion-baskets": "石笼网",
  "hexagonal-wire-mesh": "六角网",
  "expanded-metal": "扩张网 / 冲孔板",
  "perforated-metal": "扩张网 / 冲孔板",
};
---
<Base title="提交丝网询盘 — 获取安平工厂报价" description="一份结构化询盘，直接发送给匹配的安平丝网工厂。买家免费使用。" lang="zh">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-extrabold">提交询盘</h1>
    <p class="mt-2 text-theme-secondary">填写您的规格——我们会将其转发给安平的匹配工厂。工厂会直接回复您。买家免费。</p>
    <p class="mt-3 text-sm text-theme-muted">
      也可以直接发邮件：<a href="mailto:inquiry@meshcalculator.com" class="underline hover:text-theme-primary">inquiry@meshcalculator.com</a>——同一收件箱，24小时内回复。
    </p>

    <form class="mt-8 bg-theme-card border border-theme rounded-xl p-6 space-y-5" name="inquiry" method="POST" action="https://formspree.io/f/xnpqlpoj">
      <input type="hidden" name="_subject" value="New inquiry — meshcalculator.com" />
      <input type="hidden" name="_next" value="https://meshcalculator.com/zh/inquiry/thanks/" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="factory" id="factory-input" value="" />

      <div id="factory-context" class="hidden bg-theme-secondary bg-opacity-10 border border-accent rounded-lg p-4 text-sm text-theme-secondary">
        此询盘将直接发送给：<strong id="factory-name" class="text-theme-primary"></strong>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="product">产品类型</label>
        <select id="product" name="product" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card" required>
          <option value="">请选择…</option>
          <option>不锈钢编织网</option>
          <option>焊接丝网 / 网片</option>
          <option>护栏系统</option>
          <option>石笼网</option>
          <option>扩张网 / 冲孔板</option>
          <option>其他</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1" for="spec">规格</label>
        <textarea id="spec" name="spec" rows="4" required placeholder="例如：SS304 编织网，100 目，0.10mm 丝径，1.0m 宽 × 30m 卷，数量 500 m²"
          class="w-full border border-theme rounded-lg px-3 py-2"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="email">您的邮箱</label>
          <input id="email" name="email" type="email" required class="w-full border border-theme rounded-lg px-3 py-2" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="country">国家</label>
          <input id="country" name="country" type="text" class="w-full border border-theme rounded-lg px-3 py-2" />
        </div>
      </div>
      <button type="submit" class="w-full accent-bg hover:accent-bg text-white font-semibold py-3 rounded-lg transition-colors">发送给匹配的工厂</button>
      <p class="text-xs text-theme-muted">提交即表示您同意我们的<a href="/zh/terms/" class="underline">使用条款</a>和<a href="/zh/privacy/" class="underline">隐私政策</a>。我们从不出售买家数据。</p>
    </form>
  </section>

  <script id="factory-map" type="application/json" set:html={JSON.stringify({ names: factoryNames, categories: categoryToProduct })} />
  <script is:inline>
    (function () {
      var data = { names: {}, categories: {} };
      try { data = JSON.parse(document.getElementById("factory-map").textContent); } catch (e) {}
      var params = new URLSearchParams(location.search);
      var slug = params.get("factory");
      var name = slug ? data.names[slug] : null;
      if (!name) return;
      var box = document.getElementById("factory-context");
      if (box) {
        document.getElementById("factory-name").textContent = name;
        box.classList.remove("hidden");
      }
      var fi = document.getElementById("factory-input");
      if (fi) fi.value = name;
      var subject = document.querySelector('form[name="inquiry"] input[name="_subject"]');
      if (subject) subject.value = subject.value + " — " + name;
      var label = data.categories[params.get("category") || ""];
      if (label) {
        var sel = document.getElementById("product");
        if (sel) {
          for (var i = 0; i < sel.options.length; i++) {
            if (sel.options[i].text === label) { sel.selectedIndex = i; break; }
          }
        }
      }
    })();
  </script>
</Base>
