---
import Base from "../../layouts/Base.astro";

const products = [
  "普通钢格栅",
  "防滑齿型钢格栅",
  "热镀锌钢格栅",
  "不锈钢格栅（304）",
  "不锈钢格栅（316L）",
  "铝合金格栅",
  "格栅踏步板",
  "排水沟盖板",
  "重型钢格栅",
  "其他 / 多种产品",
];

const categoryToProduct: Record<string, string> = {
  "plain-steel-grating": "普通钢格栅",
  "serrated-steel-grating": "防滑齿型钢格栅",
  "galvanized-grating": "热镀锌钢格栅",
  "stainless-steel-grating": "不锈钢格栅（304）",
  "aluminum-grating": "铝合金格栅",
  "stair-treads": "格栅踏步板",
  "trench-covers": "排水沟盖板",
  "heavy-duty-grating": "重型钢格栅",
};

const input = "w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary";
const label = "block text-sm font-semibold mb-1 text-theme-primary";
---

<Base title="提交钢格栅询盘 — 获取安平工厂报价 | SteelGratingCalculator" description="一份结构化询盘，直接发送给匹配的安平钢格栅工厂。无中间商，无贸易商加价。买家免费。" lang="zh">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <div class="mb-6">
      <h1 class="text-3xl font-semibold text-theme-primary">提交钢格栅询盘</h1>
      <p class="mt-2 text-theme-secondary">填写您的规格——我们将询盘转发给匹配的安平工厂。工厂直接回复您。买家免费，无中间商。</p>
      <p class="mt-3 text-sm text-theme-muted">
        也可以直接发邮件：<a href="mailto:inquiry@steelgratingcalculator.com" class="underline hover:text-theme-primary">inquiry@steelgratingcalculator.com</a>——同一收件箱，24小时内回复。
      </p>
    </div>

    <form class="bg-theme-card border border-theme rounded-xl p-6 space-y-7" name="inquiry" method="POST" action="https://formspree.io/f/mbgljvar">
      <input type="hidden" name="_subject" value="新钢格栅询盘 — steelgratingcalculator.com" />
      <input type="hidden" name="_next" value="https://steelgratingcalculator.com/zh/inquiry/thanks/" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <!-- ① 产品规格 -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">① 产品规格</legend>
        <div>
          <label class={label} for="product">产品类型</label>
          <select id="product" name="product" class={input} required>
            <option value="">请选择…</option>
            {products.map(p => <option>{p}</option>)}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="bearing_bar_spec">承重扁钢规格</label>
            <input id="bearing_bar_spec" name="bearing_bar_spec" type="text" class={input} placeholder="例：25×5mm @ 30mm 间距" />
          </div>
          <div>
            <label class={label} for="cross_bar_spec">横杆规格</label>
            <input id="cross_bar_spec" name="cross_bar_spec" type="text" class={input} placeholder="例：6mm 圆钢 @ 50mm 间距" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="panel_size">面板尺寸</label>
            <input id="panel_size" name="panel_size" type="text" class={input} placeholder="例：6000×1000mm" />
          </div>
          <div>
            <label class={label} for="surface_finish">表面处理</label>
            <select id="surface_finish" name="surface_finish" class={input}>
              <option value="">请选择…</option>
              <option>黑色（涂油）</option>
              <option>热镀锌</option>
              <option>喷漆</option>
              <option>不锈钢（见规格）</option>
              <option>其他</option>
            </select>
          </div>
        </div>
        <div>
          <label class={label} for="quantity">数量 <span class="text-theme-muted font-normal">（含单位）</span></label>
          <input id="quantity" name="quantity" type="text" class={input} placeholder="例：500 m² / 80 块面板 / 3 吨" />
        </div>
        <div>
          <label class={label} for="message">备注 / 图纸参考 <span class="text-theme-muted font-normal">（选填）</span></label>
          <textarea id="message" name="message" rows="3" class={input} placeholder="应用场景、公差要求、所需认证、图纸、NAAMM/BS 4592 标准要求…"></textarea>
        </div>
      </fieldset>

      <!-- ② 贸易条件 -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">② 贸易与目的地</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="trade_term">贸易术语</label>
            <select id="trade_term" name="trade_term" class={input}>
              <option value="">请选择…</option>
              <option>FOB</option><option>CIF</option><option>CFR</option>
              <option>EXW</option><option>DAP / DDP</option>
              <option>不确定，请建议</option>
            </select>
          </div>
          <div>
            <label class={label} for="destination_port">目的港 / 城市</label>
            <input id="destination_port" name="destination_port" type="text" class={input} placeholder="例：汉堡、洛杉矶、杰贝阿里" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="target_price">目标价格 <span class="text-theme-muted font-normal">（选填）</span></label>
            <input id="target_price" name="target_price" type="text" class={input} placeholder="例：USD 15/m² FOB" />
          </div>
          <div>
            <label class={label} for="timeline">采购时间</label>
            <select id="timeline" name="timeline" class={input}>
              <option value="">请选择…</option>
              <option>立即</option><option>1个月内</option>
              <option>1–3个月</option><option>3个月以上 / 调研阶段</option>
            </select>
          </div>
        </div>
      </fieldset>

      <!-- ③ 联系方式 -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">③ 您的联系方式</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="name">姓名</label>
            <input id="name" name="name" type="text" required class={input} />
          </div>
          <div>
            <label class={label} for="email">工作邮箱</label>
            <input id="email" name="email" type="email" required class={input} placeholder="name@company.com" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="company">公司名称</label>
            <input id="company" name="company" type="text" required class={input} />
          </div>
          <div>
            <label class={label} for="website">公司网站 <span class="text-theme-muted font-normal">（选填）</span></label>
            <input id="website" name="website" type="url" class={input} placeholder="https://…" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="whatsapp">WhatsApp <span class="text-theme-muted font-normal">（选填）</span></label>
            <input id="whatsapp" name="whatsapp" type="tel" class={input} placeholder="+1 …" />
          </div>
          <div>
            <label class={label} for="country">国家</label>
            <input id="country" name="country" type="text" required class={input} />
          </div>
        </div>
      </fieldset>

      <button type="submit" class="w-full accent-bg hover:opacity-90 on-accent font-semibold py-3 rounded-lg transition-opacity">发送给匹配的工厂</button>
      <p class="text-xs text-theme-muted">提交即表示您同意我们的<a href="/zh/terms/" class="underline">使用条款</a>和<a href="/zh/privacy/" class="underline">隐私政策</a>。我们从不出售买家数据。</p>
    </form>
  </section>

  <script id="cat-map" type="application/json" set:html={JSON.stringify(categoryToProduct)} />
  <script is:inline>
    (function () {
      var catMap = {};
      try { catMap = JSON.parse(document.getElementById("cat-map").textContent); } catch (e) {}
      var params = new URLSearchParams(location.search);
      var cat = params.get("category");
      var bbSpec = params.get("bb_spec");
      var panel = params.get("panel");
      var qty = params.get("qty");

      if (cat && catMap[cat]) {
        var sel = document.getElementById("product");
        if (sel) {
          var opts = sel.options;
          for (var i = 0; i < opts.length; i++) {
            if (opts[i].text === catMap[cat]) { sel.selectedIndex = i; break; }
          }
        }
      }
      if (bbSpec) {
        var bb = document.getElementById("bearing_bar_spec");
        if (bb) bb.value = decodeURIComponent(bbSpec);
      }
      if (panel) {
        var ps = document.getElementById("panel_size");
        if (ps) ps.value = decodeURIComponent(panel);
      }
      if (qty) {
        var q = document.getElementById("quantity");
        if (q) q.value = qty + " 块";
      }
    })();
  </script>
</Base>
