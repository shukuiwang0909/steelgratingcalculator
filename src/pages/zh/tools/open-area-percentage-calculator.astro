---
import Base from "../../../layouts/Base.astro";

const title = "钢格栅开孔率计算器 — 排水与通风设计 | 免费";
const description = "计算任意规格钢格栅的开孔率（百分比）。开孔率决定排水能力、通风量和防积灰性能。输入承重扁钢和横杆尺寸，即刻获取结果。";
---
<Base title={title} description={description} lang="zh">

  <section class="max-w-6xl mx-auto px-4 py-10">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/zh/" class="hover:text-theme-primary transition-colors">首页</a>
      <span>/</span>
      <a href="/zh/tools/open-area-percentage-calculator/" class="accent-text">开孔率计算器</a>
    </nav>

    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-theme accent-border accent-text text-xs font-mono uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full accent-bg animate-pulse"></span>
        工具 03 · 排水设计
      </div>
      <h1 class="text-3xl font-semibold text-theme-primary mb-3">钢格栅开孔率计算器</h1>
      <p class="text-theme-secondary max-w-2xl leading-relaxed">
        计算任意规格钢格栅的开孔率。开孔率决定排水能力、通风量、采光透过率和积灰情况。输入承重扁钢和横杆尺寸，即刻得出结果。
      </p>
    </div>

    <div class="grid lg:grid-cols-[1fr_380px] gap-6">

      <!-- 左列：输入参数 -->
      <div class="space-y-5">

        <!-- 承重扁钢 -->
        <div class="card">
          <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide mb-4 flex items-center gap-2">
            <span class="w-1 h-4 accent-bg rounded-full"></span>
            承重扁钢
          </h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="label" for="oa-bb-thick">厚度（mm）</label>
              <select id="oa-bb-thick" class="select">
                <option value="3">3 mm</option>
                <option value="4">4 mm</option>
                <option value="5" selected>5 mm</option>
              </select>
              <p class="input-hint">上表面宽度 = 厚度 T</p>
            </div>
            <div>
              <label class="label" for="oa-bb-pitch">间距 c/c（mm）</label>
              <select id="oa-bb-pitch" class="select">
                <option value="11">11 mm</option>
                <option value="15">15 mm</option>
                <option value="22">22 mm</option>
                <option value="30" selected>30 mm</option>
                <option value="34">34 mm</option>
                <option value="40">40 mm</option>
                <option value="41">41 mm</option>
                <option value="60">60 mm</option>
                <option value="76">76 mm</option>
              </select>
              <p class="input-hint">中心距间距</p>
            </div>
          </div>
        </div>

        <!-- 横杆 -->
        <div class="card">
          <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide mb-4 flex items-center gap-2">
            <span class="w-1 h-4 accent-bg rounded-full"></span>
            横杆
          </h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="label" for="oa-xb-size">直径/边长（mm）</label>
              <select id="oa-xb-size" class="select">
                <option value="5">5 mm</option>
                <option value="6" selected>6 mm</option>
                <option value="8">8 mm</option>
                <option value="10">10 mm</option>
              </select>
              <p class="input-hint">圆钢直径或扭方钢边长</p>
            </div>
            <div>
              <label class="label" for="oa-xb-pitch">间距（mm）</label>
              <select id="oa-xb-pitch" class="select">
                <option value="25">25 mm (1")</option>
                <option value="50" selected>50 mm (2")</option>
                <option value="76.2">76.2 mm (3")</option>
                <option value="100">100 mm (4")</option>
              </select>
              <p class="input-hint">横杆中心距</p>
            </div>
          </div>
        </div>

        <!-- 计算公式 -->
        <div class="card bg-theme-tertiary">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-theme-muted mb-3">计算公式</h3>
          <div class="font-mono text-sm accent-text">
            <p>开孔率% =</p>
            <p class="ml-4">[(P_bb − T_bb) / P_bb]</p>
            <p class="ml-4">× [(P_xb − d_xb) / P_xb]</p>
            <p class="ml-4">× 100</p>
          </div>
          <div class="mt-4 text-xs text-theme-secondary space-y-1">
            <p><span class="text-theme-muted">P_bb</span> = 承重扁钢间距（c/c）</p>
            <p><span class="text-theme-muted">T_bb</span> = 承重扁钢厚度</p>
            <p><span class="text-theme-muted">P_xb</span> = 横杆间距（c/c）</p>
            <p><span class="text-theme-muted">d_xb</span> = 横杆直径或边长</p>
          </div>
        </div>

        <!-- 开孔率应用指南 -->
        <div class="card">
          <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide mb-4 flex items-center gap-2">
            <span class="w-1 h-4 accent-bg rounded-full"></span>
            开孔率应用参考
          </h2>
          <div class="space-y-2 text-sm">
            <div class="flex items-start gap-3 p-3 bg-theme-tertiary rounded-lg">
              <span class="w-3 h-3 rounded-full bg-red-500 mt-0.5 shrink-0"></span>
              <div>
                <p class="font-medium text-theme-primary">&lt; 40% — 排水能力弱</p>
                <p class="text-theme-secondary text-xs mt-0.5">结构承重楼板、重型车辆区域。不适合积水环境。</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 bg-theme-tertiary rounded-lg">
              <span class="w-3 h-3 rounded-full bg-amber-400 mt-0.5 shrink-0"></span>
              <div>
                <p class="font-medium text-theme-primary">40–55% — 标准工业级</p>
                <p class="text-theme-secondary text-xs mt-0.5">最常用范围。适合走道、平台、夹层楼板，排水能力中等。</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 bg-theme-tertiary rounded-lg">
              <span class="w-3 h-3 rounded-full bg-green-400 mt-0.5 shrink-0"></span>
              <div>
                <p class="font-medium text-theme-primary">55–70% — 良好排水</p>
                <p class="text-theme-secondary text-xs mt-0.5">适合湿式加工区、沟盖板、石油化工平台。</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 bg-theme-tertiary rounded-lg">
              <span class="w-3 h-3 rounded-full bg-emerald-400 mt-0.5 shrink-0"></span>
              <div>
                <p class="font-medium text-theme-primary">&gt; 70% — 高流量</p>
                <p class="text-theme-secondary text-xs mt-0.5">排水格栅、筛分、过滤应用，最大化水流和气流。</p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 右列：结果 -->
      <div>
        <div class="card sticky top-20 space-y-4">
          <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide">开孔率结果</h2>

          <!-- 圆环图 -->
          <div class="flex flex-col items-center py-4">
            <div class="relative w-40 h-40">
              <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90">
                <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-width="12" class="text-theme-tertiary"/>
                <circle id="donut-arc" cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-width="12"
                  stroke-dasharray="238.76" stroke-dashoffset="238.76" stroke-linecap="round"
                  class="accent-text transition-all duration-500"/>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <p id="result-pct-big" class="text-3xl font-bold text-theme-primary font-mono">—</p>
                <p class="text-xs text-theme-muted">开孔</p>
              </div>
            </div>
          </div>

          <div class="p-4 accent-bg rounded-lg text-center">
            <p class="text-xs uppercase tracking-wide mb-1 on-accent opacity-80">开孔率</p>
            <p id="result-open" class="text-3xl font-bold on-accent font-mono">—</p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="p-3 bg-theme-tertiary rounded-lg border border-theme text-center">
              <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">实体面积</p>
              <p id="result-solid" class="text-xl font-bold text-theme-primary font-mono">—</p>
            </div>
            <div class="p-3 bg-theme-tertiary rounded-lg border border-theme text-center">
              <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">扁钢方向开孔</p>
              <p id="result-bb-open" class="text-xl font-bold text-theme-primary font-mono">—</p>
            </div>
          </div>

          <div class="p-3 bg-theme-tertiary rounded-lg border border-theme">
            <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">适用等级</p>
            <div id="result-rating" class="flex items-center gap-2 mt-1">
              <span id="rating-dot" class="w-3 h-3 rounded-full bg-theme-muted shrink-0"></span>
              <p id="rating-text" class="text-sm font-medium text-theme-primary">—</p>
            </div>
          </div>

          <div class="p-3 bg-theme-tertiary rounded-lg border border-theme text-xs font-mono text-theme-secondary">
            <p class="text-theme-muted mb-1">承重扁钢净间隙：</p>
            <p id="result-bb-gap" class="accent-text">—</p>
            <p class="text-theme-muted mt-2 mb-1">横杆净间隙：</p>
            <p id="result-xb-gap" class="accent-text">—</p>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button id="btn-copy-oa" class="flex items-center justify-center gap-2 border border-theme rounded-lg py-2 text-sm text-theme-secondary hover:text-theme-primary transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              复制
            </button>
            <a href="/zh/inquiry/" class="flex items-center justify-center gap-2 accent-bg rounded-lg py-2 text-sm font-semibold on-accent hover:opacity-90 transition-opacity">
              获取报价
            </a>
          </div>
          <p id="oa-copy-feedback" class="hidden text-xs text-center text-green-400">已复制！</p>
        </div>
      </div>

    </div>

    <!-- 相关工具 -->
    <div class="mt-12 pt-8 border-t border-theme">
      <h2 class="text-lg font-semibold text-theme-primary mb-4">相关工具</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/zh/tools/steel-grating-weight-calculator/" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">工具 01</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">重量计算器</h3>
          <p class="text-sm text-theme-secondary mt-1">每平方米重量和面板重量。</p>
        </a>
        <a href="/zh/tools/bar-grating-load-capacity-calculator/" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">工具 02</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">承载能力计算器</h3>
          <p class="text-sm text-theme-secondary mt-1">NAAMM & BS 4592 允许均布荷载。</p>
        </a>
        <a href="/zh/tools/fob-price-calculator/" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">工具 05</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">FOB 价格计算器</h3>
          <p class="text-sm text-theme-secondary mt-1">人民币出厂价 → FOB 美元报价。</p>
        </a>
      </div>
    </div>

  </section>

</Base>

<script>
(function () {
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const getNum = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement | HTMLSelectElement)?.value || '0') || 0;

  const CIRCUMFERENCE = 2 * Math.PI * 38;

  function calc(): void {
    const T_bb = getNum('oa-bb-thick');
    const P_bb = getNum('oa-bb-pitch');
    const d_xb = getNum('oa-xb-size');
    const P_xb = getNum('oa-xb-pitch');

    if (!T_bb || !P_bb || !d_xb || !P_xb) return;

    const bb_open_frac = (P_bb - T_bb) / P_bb;
    const xb_open_frac = (P_xb - d_xb) / P_xb;
    const open_pct = bb_open_frac * xb_open_frac * 100;
    const solid_pct = 100 - open_pct;
    const bb_gap = P_bb - T_bb;
    const xb_gap = P_xb - d_xb;

    let ratingColor = 'bg-theme-muted', ratingText = '—';
    if (open_pct < 40) { ratingColor = 'bg-red-500'; ratingText = '排水能力弱——仅适用结构承重'; }
    else if (open_pct < 55) { ratingColor = 'bg-amber-400'; ratingText = '标准工业级——走道、平台'; }
    else if (open_pct < 70) { ratingColor = 'bg-green-400'; ratingText = '良好排水——湿式/加工区'; }
    else { ratingColor = 'bg-emerald-400'; ratingText = '优异排水——高流量应用'; }

    const bigEl = $('result-pct-big');
    if (bigEl) bigEl.textContent = open_pct.toFixed(1) + '%';
    const openEl = $('result-open');
    if (openEl) openEl.textContent = open_pct.toFixed(2) + '%';
    const solidEl = $('result-solid');
    if (solidEl) solidEl.textContent = solid_pct.toFixed(2) + '%';
    const bbOpenEl = $('result-bb-open');
    if (bbOpenEl) bbOpenEl.textContent = (bb_open_frac * 100).toFixed(1) + '%';
    const bbGapEl = $('result-bb-gap');
    if (bbGapEl) bbGapEl.textContent = `${bb_gap} mm 净间隙`;
    const xbGapEl = $('result-xb-gap');
    if (xbGapEl) xbGapEl.textContent = `${xb_gap.toFixed(1)} mm 净间隙`;
    const dotEl = $('rating-dot');
    if (dotEl) { dotEl.className = `w-3 h-3 rounded-full shrink-0 ${ratingColor}`; }
    const ratingTextEl = $('rating-text');
    if (ratingTextEl) ratingTextEl.textContent = ratingText;

    const arc = document.getElementById('donut-arc') as SVGCircleElement | null;
    if (arc) {
      const offset = CIRCUMFERENCE * (1 - open_pct / 100);
      arc.style.strokeDashoffset = String(offset);
    }
  }

  function copyResult(): void {
    const open = $('result-open')?.textContent || '';
    const solid = $('result-solid')?.textContent || '';
    const rating = $('rating-text')?.textContent || '';
    const T_bb = getNum('oa-bb-thick'), P_bb = getNum('oa-bb-pitch');
    const d_xb = getNum('oa-xb-size'), P_xb = getNum('oa-xb-pitch');
    const text = [
      `钢格栅开孔率计算结果`,
      `扁钢：${T_bb}mm厚 @ ${P_bb}mm间距 | 横杆：${d_xb}mm @ ${P_xb}mm间距`,
      `---`,
      `开孔率：${open}`,
      `实体面积：${solid}`,
      `适用等级：${rating}`,
      `计算来源：SteelGratingCalculator.com`,
    ].join('\n');
    navigator.clipboard.writeText(text).then(() => {
      const fb = $('oa-copy-feedback');
      if (fb) { fb.classList.remove('hidden'); setTimeout(() => fb.classList.add('hidden'), 2500); }
    });
  }

  document.querySelectorAll('#oa-bb-thick,#oa-bb-pitch,#oa-xb-size,#oa-xb-pitch')
    .forEach(el => el.addEventListener('change', calc));
  document.getElementById('btn-copy-oa')?.addEventListener('click', copyResult);

  calc();
})();
</script>

<style>
  .label { display:block; font-size:.75rem; font-weight:600; margin-bottom:.25rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; }
  .select { width:100%; border:1px solid var(--border-color); border-radius:.5rem; padding:.5rem .75rem; background-color:var(--bg-secondary); color:var(--text-primary); font-size:.875rem; outline:none; transition:all .2s; }
  .select:focus { box-shadow:0 0 0 1px #f59e0b; }
  .input-hint { margin-top:.25rem; font-size:.75rem; color:var(--text-muted); }
</style>
