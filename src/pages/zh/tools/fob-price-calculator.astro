---
import Base from "../../../layouts/Base.astro";
---

<Base title="FOB价格计算器 — 多币种外贸报价工具 | MeshCalculator" description="将人民币出厂价转换为美元、欧元、英镑FOB报价。实时汇率，含内陆运费、港杂费、退税计算。" lang="zh">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-theme-primary">FOB价格计算器</h1>
    <p class="mt-2 text-theme-secondary">将人民币出厂价转换为多币种FOB报价。实时汇率更新。</p>

    <div class="mt-8 bg-theme-card border border-theme rounded-xl p-6 grid md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="rmbPrice">出厂价 (¥/件)</label>
          <input id="rmbPrice" type="number" step="0.01" value="10.00" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
        </div>

        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="quantity">采购数量 (件)</label>
          <input id="quantity" type="number" step="1" value="1000" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-1 text-theme-primary" for="inland">内陆运费 (¥/件)</label>
            <input id="inland" type="number" step="0.01" value="0.50" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1 text-theme-primary" for="port">港杂费 (¥/件)</label>
            <input id="port" type="number" step="0.01" value="0.30" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="taxRate">退税率 (%)</label>
          <input id="taxRate" type="number" step="0.1" value="13" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary" />
          <p class="text-xs text-theme-muted mt-1">丝网产品通常13%</p>
        </div>

        <div>
          <label class="block text-sm font-semibold mb-1 text-theme-primary" for="targetCurrency">目标货币</label>
          <select id="targetCurrency" class="w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary">
            <option value="USD" selected>美元 (USD)</option>
            <option value="EUR">欧元 (EUR)</option>
            <option value="GBP">英镑 (GBP)</option>
          </select>
        </div>
      </div>

      <div class="bg-theme-tertiary rounded-lg p-6 flex flex-col justify-center border border-theme">
        <p class="text-sm font-semibold text-theme-muted uppercase tracking-wide">FOB单价</p>
        <p id="fobPrice" class="text-4xl font-bold mt-2 text-theme-primary">—</p>
        <p id="totalValue" class="mt-2 text-lg text-theme-secondary">—</p>
        <p id="exchangeRate" class="mt-4 text-sm text-theme-muted">—</p>
        
        <div class="mt-6 flex flex-wrap gap-2">
          <button id="copyBtn" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity on-accent">复制结果</button>
          <button id="shareBtn" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-muted transition-colors text-theme-primary">分享链接</button>
        </div>
      </div>
    </div>

    <div class="mt-10 prose max-w-none text-theme-secondary">
      <h2 class="text-xl font-bold text-theme-primary">计算说明</h2>
      <p class="bg-theme-tertiary border border-theme rounded-lg px-4 py-3 font-mono text-sm text-theme-primary">
        FOB = (出厂价 + 内陆运费 + 港杂费 - 退税) ÷ 汇率
      </p>
      <ul class="list-disc pl-5 space-y-2">
        <li><strong class="text-theme-primary">出厂价</strong>：工厂RMB报价</li>
        <li><strong class="text-theme-primary">内陆运费</strong>：工厂到港口的运输成本</li>
        <li><strong class="text-theme-primary">港杂费</strong>：装卸、报关、文件费用</li>
        <li><strong class="text-theme-primary">退税</strong>：出口退税率 × 出厂价 ÷ (1 + 增值税率)</li>
      </ul>
      <p class="text-sm text-theme-muted mt-4">汇率来源：open.er-api.com（免费版）。汇率每日更新，实际报价请以银行实时汇率为准。</p>
    </div>
  </section>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

    // Exchange rates: 1 CNY = X foreign currency (from open.er-api.com, cached 24h)
    let rates: Record<string, number> = {
      USD: 0.138,  // fallback
      EUR: 0.127,
      GBP: 0.110
    };

    const FX_CACHE_KEY = "mc_fx_cny_rates";
    const FX_TTL = 24 * 60 * 60 * 1000; // 24h

    function readCache(): { rates: Record<string, number>; ts: number } | null {
      try {
        const raw = localStorage.getItem(FX_CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (parsed && parsed.rates && typeof parsed.ts === "number") return parsed;
      } catch (e) {}
      return null;
    }

    function writeCache() {
      try {
        localStorage.setItem(FX_CACHE_KEY, JSON.stringify({ rates, ts: Date.now() }));
      } catch (e) {}
    }

    async function fetchRates() {
      // 缓存 24h 内直接复用，不重复请求
      const cached = readCache();
      if (cached && Date.now() - cached.ts < FX_TTL) {
        rates = { ...rates, ...cached.rates };
        calc();
        return;
      }
      try {
        const res = await fetch("https://open.er-api.com/v6/latest/CNY");
        const data = await res.json();
        if (data && data.rates) {
          rates.USD = data.rates.USD || rates.USD;
          rates.EUR = data.rates.EUR || rates.EUR;
          rates.GBP = data.rates.GBP || rates.GBP;
          writeCache();
        }
      } catch (e) {
        // 请求失败：有缓存用缓存（可能已过期），没有则用 fallback 值
        const stale = readCache();
        if (stale) rates = { ...rates, ...stale.rates };
      }
      calc();
    }

    function calc() {
      const rmb = parseFloat($("rmbPrice").value) || 0;
      const qty = parseInt($("quantity").value) || 0;
      const inland = parseFloat($("inland").value) || 0;
      const port = parseFloat($("port").value) || 0;
      const taxRate = parseFloat($("taxRate").value) || 0;
      const currency = $("targetCurrency").value;

      // Calculate FOB price
      const taxRebate = rmb * (taxRate / 100) / 1.13;
      const totalRMB = rmb + inland + port - taxRebate;
      const rate = rates[currency] || 0.138;
      const fob = totalRMB * rate;

      $("fobPrice").textContent = fob.toFixed(2) + " " + currency;
      $("totalValue").textContent = qty > 0 
        ? `总价: ${(fob * qty).toFixed(2)} ${currency} (${qty.toLocaleString()} 件)` 
        : "";
      $("exchangeRate").textContent = `1 CNY ≈ ${rate.toFixed(4)} ${currency}`;
    }

    function copyResult() {
      const text = `FOB价格计算结果
出厂价: ¥${$("rmbPrice").value}/件
数量: ${$("quantity").value} 件
内陆运费: ¥${$("inland").value}/件
港杂费: ¥${$("port").value}/件
退税率: ${$("taxRate").value}%

FOB单价: ${$("fobPrice").textContent}
${$("totalValue").textContent}
${$("exchangeRate").textContent}

由 MeshCalculator 计算`;
      
      navigator.clipboard.writeText(text).then(() => {
        const btn = $("copyBtn");
        const original = btn.textContent;
        btn.textContent = "已复制!";
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    }

    function shareLink() {
      const params = new URLSearchParams({
        rmb: $("rmbPrice").value,
        qty: $("quantity").value,
        inland: $("inland").value,
        port: $("port").value,
        tax: $("taxRate").value,
        cur: $("targetCurrency").value
      });
      const url = window.location.origin + window.location.pathname + "?" + params.toString();
      navigator.clipboard.writeText(url).then(() => {
        const btn = $("shareBtn");
        const original = btn.textContent;
        btn.textContent = "链接已复制!";
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    }

    // Event listeners
    ["rmbPrice", "quantity", "inland", "port", "taxRate"].forEach(id => {
      $(id).addEventListener("input", calc);
    });
    $("targetCurrency").addEventListener("change", calc);
    $("copyBtn").addEventListener("click", copyResult);
    $("shareBtn").addEventListener("click", shareLink);

    // Load from URL params
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("rmb")) $("rmbPrice").value = urlParams.get("rmb")!;
    if (urlParams.get("qty")) $("quantity").value = urlParams.get("qty")!;
    if (urlParams.get("inland")) $("inland").value = urlParams.get("inland")!;
    if (urlParams.get("port")) $("port").value = urlParams.get("port")!;
    if (urlParams.get("tax")) $("taxRate").value = urlParams.get("tax")!;
    if (urlParams.get("cur")) $("targetCurrency").value = urlParams.get("cur")!;

    // Initialize
    fetchRates();
  </script>
</Base>
