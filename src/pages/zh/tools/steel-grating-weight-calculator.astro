---
import Base from "../../../layouts/Base.astro";

const title = "钢格栅重量计算器 — 每平方米重量 · 面板重量 · 订单总重 | 免费";
const description = "免费在线钢格栅重量计算器。输入承重扁钢高度、厚度、间距，横杆规格和材质，即可计算每平方米重量、面板重量和订单总重。符合GB/T 12755标准。";
---
<Base title={title} description={description} lang="zh">

  <section class="max-w-6xl mx-auto px-4 py-10">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/zh/" class="hover:text-theme-primary transition-colors">首页</a>
      <span>/</span>
      <a href="/zh/tools/steel-grating-weight-calculator/" class="accent-text">钢格栅重量计算器</a>
    </nav>

    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-theme accent-border accent-text text-xs font-mono uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full accent-bg"></span>
        工具 01 · GB/T 12755
      </div>
      <h1 class="text-3xl font-semibold text-theme-primary mb-3">钢格栅重量计算器</h1>
      <p class="text-theme-secondary max-w-2xl leading-relaxed">
        计算任意规格钢格栅的重量——每平方米重量、单块面板重量和订单总重。支持碳钢、不锈钢304/316及铝合金。承重扁钢与横杆分别计算。
      </p>
    </div>

    <div class="grid lg:grid-cols-[1fr_380px] gap-6">

      <!-- 左列：输入参数 -->
      <div class="space-y-5">

        <!-- 承重扁钢 -->
        <div class="card">
          <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide mb-4 flex items-center gap-2">
            <span class="w-1 h-4 accent-bg rounded-full"></span>
            承重扁钢
          </h2>
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="label" for="bb-height">高度（mm）</label>
              <select id="bb-height" class="select">
                <option value="20">20 mm</option>
                <option value="25" selected>25 mm</option>
                <option value="30">30 mm</option>
                <option value="35">35 mm</option>
                <option value="40">40 mm</option>
                <option value="50">50 mm</option>
                <option value="65">65 mm</option>
                <option value="75">75 mm</option>
              </select>
              <p class="input-hint">扁钢截面高度 H</p>
            </div>
            <div>
              <label class="label" for="bb-thickness">厚度（mm）</label>
              <select id="bb-thickness" class="select">
                <option value="3">3 mm</option>
                <option value="4">4 mm</option>
                <option value="5" selected>5 mm</option>
              </select>
              <p class="input-hint">腹板厚度 T</p>
            </div>
            <div>
              <label class="label" for="bb-pitch">间距 c/c（mm）</label>
              <select id="bb-pitch" class="select">
                <option value="11">11 mm</option>
                <option value="15">15 mm</option>
                <option value="22">22 mm</option>
                <option value="30" selected>30 mm</option>
                <option value="34">34 mm</option>
                <option value="40">40 mm</option>
                <option value="41">41 mm (1-5/8")</option>
                <option value="60">60 mm</option>
                <option value="76">76 mm (3")</option>
              </select>
              <p class="input-hint">中心距间距</p>
            </div>
          </div>
        </div>

        <!-- 横杆 -->
        <div class="card">
          <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide mb-4 flex items-center gap-2">
            <span class="w-1 h-4 accent-bg rounded-full"></span>
            横杆
          </h2>
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="label" for="xb-type">类型</label>
              <select id="xb-type" class="select">
                <option value="round" selected>圆钢</option>
                <option value="square">扭方钢</option>
              </select>
              <p class="input-hint">圆钢=π/4·d²·ρ，扭方=d²·ρ</p>
            </div>
            <div>
              <label class="label" for="xb-size">直径/边长（mm）</label>
              <select id="xb-size" class="select">
                <option value="5">5 mm</option>
                <option value="6" selected>6 mm</option>
                <option value="8">8 mm</option>
                <option value="10">10 mm</option>
                <option value="12">12 mm</option>
              </select>
              <p class="input-hint">圆钢直径或方钢边长</p>
            </div>
            <div>
              <label class="label" for="xb-pitch">间距（mm）</label>
              <select id="xb-pitch" class="select">
                <option value="25">25 mm (1")</option>
                <option value="50" selected>50 mm (2")</option>
                <option value="76.2">76.2 mm (3")</option>
                <option value="100">100 mm (4")</option>
              </select>
              <p class="input-hint">横杆中心距</p>
            </div>
          </div>
        </div>

        <!-- 材质与面板 -->
        <div class="card">
          <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide mb-4 flex items-center gap-2">
            <span class="w-1 h-4 accent-bg rounded-full"></span>
            材质与面板尺寸
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
              <label class="label" for="material">材质</label>
              <select id="material" class="select">
                <option value="7.85" selected>碳钢 Q235/A36</option>
                <option value="7.93">不锈钢 SS 304</option>
                <option value="7.98">不锈钢 SS 316</option>
                <option value="2.7">铝合金 6061</option>
              </select>
              <p class="input-hint">密度 g/cm³</p>
            </div>
            <div>
              <label class="label" for="panel-length">面板长度（mm）</label>
              <input id="panel-length" type="number" min="100" max="12000" value="6000" class="input" />
              <p class="input-hint">出口标准 6000mm</p>
            </div>
            <div>
              <label class="label" for="panel-width">面板宽度（mm）</label>
              <input id="panel-width" type="number" min="100" max="3000" value="1000" class="input" />
              <p class="input-hint">标准宽度 1000mm</p>
            </div>
            <div>
              <label class="label" for="quantity">数量（块）</label>
              <input id="quantity" type="number" min="1" value="10" class="input" />
              <p class="input-hint">订购块数</p>
            </div>
          </div>
          <!-- 热镀锌选项 -->
          <div class="mt-4 flex items-center gap-3 p-3 bg-theme-tertiary rounded-lg border border-theme">
            <input id="galvanized" type="checkbox" class="w-4 h-4 accent-amber-500" />
            <div>
              <label for="galvanized" class="text-sm font-medium text-theme-primary cursor-pointer">热镀锌（+4%）</label>
              <p class="text-xs text-theme-muted">按 ISO 1461 约增加 610 g/m² 锌层</p>
            </div>
          </div>
        </div>

        <!-- 公式参考 -->
        <div class="card bg-theme-tertiary">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-theme-muted mb-3">计算公式</h3>
          <div class="grid md:grid-cols-2 gap-3 text-xs font-mono text-theme-secondary">
            <div>
              <p class="text-theme-muted mb-1">承重扁钢（kg/m²）：</p>
              <p class="accent-text">W_bb = H × T × ρ / P_bb</p>
            </div>
            <div>
              <p class="text-theme-muted mb-1">横杆—圆钢（kg/m²）：</p>
              <p class="accent-text">W_xb = π/4 × d² × ρ / P_xb</p>
            </div>
            <div>
              <p class="text-theme-muted mb-1">横杆—扭方钢：</p>
              <p class="accent-text">W_xb = d² × ρ / P_xb</p>
            </div>
            <div>
              <p class="text-theme-muted mb-1">总重：</p>
              <p class="accent-text">W = W_bb + W_xb (kg/m²)</p>
            </div>
          </div>
          <p class="text-xs text-theme-muted mt-3">H、T、d 单位 mm；P 单位 mm；ρ 单位 g/cm³。</p>
        </div>

      </div>

      <!-- 右列：结果 -->
      <div class="space-y-4">
        <div class="card sticky top-20">
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-sm font-semibold text-theme-primary uppercase tracking-wide">计算结果</h2>
            <span id="calc-standard" class="text-xs font-mono text-theme-muted">GB/T 12755</span>
          </div>

          <div class="space-y-3">
            <div class="p-3 bg-theme-tertiary rounded-lg border border-theme">
              <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">承重扁钢贡献</p>
              <p id="result-bb" class="text-lg font-bold text-theme-primary font-mono">—</p>
            </div>
            <div class="p-3 bg-theme-tertiary rounded-lg border border-theme">
              <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">横杆贡献</p>
              <p id="result-xb" class="text-lg font-bold text-theme-primary font-mono">—</p>
            </div>
            <div class="p-4 accent-bg rounded-lg">
              <p class="text-xs uppercase tracking-wide mb-1 on-accent opacity-80">每平方米总重</p>
              <p id="result-per-m2" class="text-3xl font-bold on-accent font-mono">—</p>
            </div>
            <div class="p-3 bg-theme-tertiary rounded-lg border border-theme">
              <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">单块面板重量</p>
              <p id="result-per-panel" class="text-xl font-bold accent-text font-mono">—</p>
              <p id="panel-dims" class="text-xs text-theme-muted mt-0.5">6000 × 1000 mm</p>
            </div>
            <div id="galv-row" class="hidden p-3 bg-theme-tertiary rounded-lg border border-theme">
              <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">热镀锌后每平方米重</p>
              <p id="result-galv" class="text-lg font-bold text-theme-primary font-mono">—</p>
            </div>
            <div class="p-4 bg-theme-tertiary rounded-lg border-2 border-theme">
              <p class="text-xs text-theme-muted uppercase tracking-wide mb-1">订单总重</p>
              <p id="result-total" class="text-2xl font-bold text-theme-primary font-mono">—</p>
              <p id="result-qty-label" class="text-xs text-theme-muted mt-0.5"></p>
            </div>
          </div>

          <!-- 操作按钮 -->
          <div class="mt-5 grid grid-cols-2 gap-2">
            <button id="btn-copy" class="flex items-center justify-center gap-2 border border-theme rounded-lg py-2 text-sm text-theme-secondary hover:text-theme-primary hover:border-theme-muted transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              复制结果
            </button>
            <button id="btn-share" class="flex items-center justify-center gap-2 border border-theme rounded-lg py-2 text-sm text-theme-secondary hover:text-theme-primary hover:border-theme-muted transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
              分享链接
            </button>
            <button id="btn-print" class="flex items-center justify-center gap-2 border border-theme rounded-lg py-2 text-sm text-theme-secondary hover:text-theme-primary hover:border-theme-muted transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              打印/保存PDF
            </button>
            <a id="btn-inquiry" href="/zh/inquiry/" class="flex items-center justify-center gap-2 accent-bg rounded-lg py-2 text-sm font-semibold on-accent hover:opacity-90 transition-opacity">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              获取报价
            </a>
          </div>

          <p id="copy-feedback" class="hidden text-xs text-center text-green-400 mt-2">已复制到剪贴板！</p>

          <div class="mt-5 pt-4 border-t border-theme">
            <p class="text-xs text-theme-muted">
              所有结果为理论估算值（±2–3%），实际使用前请咨询专业工程师。镀锌重量参照 ISO 1461 约增加 610 g/m²。
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- 相关工具 -->
    <div class="mt-12 pt-8 border-t border-theme">
      <h2 class="text-lg font-semibold text-theme-primary mb-6">相关工具与指南</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/zh/tools/bar-grating-load-capacity-calculator/" class="card card-accent group">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono accent-text uppercase tracking-wider">工具 02</span>
          </div>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mb-1">承载能力计算器</h3>
          <p class="text-sm text-theme-secondary">NAAMM MBG 531 + BS 4592，可从本工具导入规格。</p>
        </a>
        <a href="/zh/tools/open-area-percentage-calculator/" class="card card-accent group">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono accent-text uppercase tracking-wider">工具 03</span>
          </div>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mb-1">开孔率计算器</h3>
          <p class="text-sm text-theme-secondary">根据扁钢间距计算排水通风开孔率。</p>
        </a>
        <a href="/charts/grating-weight-chart/" class="card card-accent group">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono accent-text uppercase tracking-wider">图表</span>
          </div>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mb-1">重量速查表</h3>
          <p class="text-sm text-theme-secondary">20种常用规格 kg/m² 速查。</p>
        </a>
      </div>
    </div>

  </section>

</Base>

<script>
(function () {
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  function getNum(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
    return parseFloat(el?.value || '0') || 0;
  }

  function calc(): void {
    const H = getNum('bb-height');
    const T = getNum('bb-thickness');
    const P_bb = getNum('bb-pitch');
    const xbType = (document.getElementById('xb-type') as HTMLSelectElement).value;
    const d = getNum('xb-size');
    const P_xb = getNum('xb-pitch');
    const rho = getNum('material');
    const L = getNum('panel-length');
    const W = getNum('panel-width');
    const qty = Math.max(1, Math.round(getNum('quantity')));
    const galv = (document.getElementById('galvanized') as HTMLInputElement).checked;

    if (!H || !T || !P_bb || !d || !P_xb || !L || !W) return;

    const w_bb = (H * T * rho) / P_bb;
    const w_xb = xbType === 'round'
      ? (Math.PI / 4 * d * d * rho) / P_xb
      : (d * d * rho) / P_xb;
    const w_m2 = w_bb + w_xb;
    const w_panel = w_m2 * (L / 1000) * (W / 1000);
    const w_total = w_panel * qty;
    const w_galv = w_m2 * 1.04;

    const bbEl = $('result-bb');
    if (bbEl) bbEl.textContent = w_bb.toFixed(3) + ' kg/m²';
    const xbEl = $('result-xb');
    if (xbEl) xbEl.textContent = w_xb.toFixed(3) + ' kg/m²';
    const m2El = $('result-per-m2');
    if (m2El) m2El.textContent = w_m2.toFixed(2) + ' kg/m²';
    const panelEl = $('result-per-panel');
    if (panelEl) panelEl.textContent = w_panel.toFixed(1) + ' kg';
    const dimsEl = $('panel-dims');
    if (dimsEl) dimsEl.textContent = `${L} × ${W} mm`;
    const totalEl = $('result-total');
    if (totalEl) {
      totalEl.textContent = w_total >= 1000
        ? (w_total / 1000).toFixed(3) + ' t'
        : w_total.toFixed(1) + ' kg';
    }
    const qtyLabelEl = $('result-qty-label');
    if (qtyLabelEl) qtyLabelEl.textContent = `${qty} 块 × ${w_panel.toFixed(1)} kg/块`;

    const galvRow = $('galv-row');
    const galvEl = $('result-galv');
    if (galvRow && galvEl) {
      if (galv) {
        galvRow.classList.remove('hidden');
        galvEl.textContent = w_galv.toFixed(2) + ' kg/m²';
      } else {
        galvRow.classList.add('hidden');
      }
    }

    const btnInquiry = document.getElementById('btn-inquiry') as HTMLAnchorElement | null;
    if (btnInquiry) {
      const matSelect = document.getElementById('material') as HTMLSelectElement;
      const matLabel = matSelect?.options[matSelect.selectedIndex]?.text || '';
      const spec = `${H}x${T}mm@${P_bb}mm-${d}mm${xbType === 'square' ? 'sq' : 'rd'}@${P_xb}mm`;
      btnInquiry.href = `/zh/inquiry/?bb_spec=${encodeURIComponent(spec)}&material=${encodeURIComponent(matLabel)}&panel=${L}x${W}mm&qty=${qty}`;
    }

    try {
      localStorage.setItem('sgc_last_bb', JSON.stringify({ H, T, P_bb, material: getNum('material') }));
    } catch (_) {}
  }

  function copyResult(): void {
    const m2 = ($('result-per-m2') as HTMLElement)?.textContent || '';
    const panel = ($('result-per-panel') as HTMLElement)?.textContent || '';
    const total = ($('result-total') as HTMLElement)?.textContent || '';
    const H = getNum('bb-height'), T = getNum('bb-thickness'), P_bb = getNum('bb-pitch');
    const d = getNum('xb-size'), P_xb = getNum('xb-pitch');
    const xbType = (document.getElementById('xb-type') as HTMLSelectElement).value;
    const matEl = document.getElementById('material') as HTMLSelectElement;
    const mat = matEl?.options[matEl.selectedIndex]?.text || '';
    const L = getNum('panel-length'), W = getNum('panel-width');
    const qty = getNum('quantity');
    const text = [
      `钢格栅重量计算结果`,
      `规格：${H}×${T}mm承重扁钢@${P_bb}mm间距 + ${d}mm${xbType === 'square' ? '扭方' : '圆'}横杆@${P_xb}mm间距`,
      `材质：${mat} | 面板：${L}×${W}mm`,
      `---`,
      `每平方米重量：${m2}`,
      `单块面板重量：${panel}`,
      `订单总重（${qty}块）：${total}`,
      `计算来源：SteelGratingCalculator.com`,
    ].join('\n');
    navigator.clipboard.writeText(text).then(() => {
      const fb = $('copy-feedback');
      if (fb) { fb.classList.remove('hidden'); setTimeout(() => fb.classList.add('hidden'), 2500); }
    });
  }

  function shareLink(): void {
    const params = new URLSearchParams({
      h: String(getNum('bb-height')),
      t: String(getNum('bb-thickness')),
      p: String(getNum('bb-pitch')),
      xt: (document.getElementById('xb-type') as HTMLSelectElement).value,
      xs: String(getNum('xb-size')),
      xp: String(getNum('xb-pitch')),
      m: String(getNum('material')),
      l: String(getNum('panel-length')),
      w: String(getNum('panel-width')),
      q: String(getNum('quantity')),
    });
    const url = `${location.origin}/zh/tools/steel-grating-weight-calculator/?${params.toString()}`;
    navigator.clipboard.writeText(url).then(() => {
      const fb = $('copy-feedback');
      if (fb) { fb.textContent = '链接已复制！'; fb.classList.remove('hidden'); setTimeout(() => { fb.textContent = '已复制到剪贴板！'; fb.classList.add('hidden'); }, 2500); }
    });
  }

  function hydrateFromParams(): void {
    const p = new URLSearchParams(location.search);
    const setSelect = (id: string, key: string) => {
      const val = p.get(key);
      const el = document.getElementById(id) as HTMLSelectElement | null;
      if (val && el) el.value = val;
    };
    const setInput = (id: string, key: string) => {
      const val = p.get(key);
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (val && el) el.value = val;
    };
    setSelect('bb-height', 'h');
    setSelect('bb-thickness', 't');
    setSelect('bb-pitch', 'p');
    setSelect('xb-type', 'xt');
    setSelect('xb-size', 'xs');
    setSelect('xb-pitch', 'xp');
    setSelect('material', 'm');
    setInput('panel-length', 'l');
    setInput('panel-width', 'w');
    setInput('quantity', 'q');
  }

  document.querySelectorAll('#bb-height,#bb-thickness,#bb-pitch,#xb-type,#xb-size,#xb-pitch,#material,#galvanized')
    .forEach(el => el.addEventListener('change', calc));
  document.querySelectorAll('#panel-length,#panel-width,#quantity')
    .forEach(el => el.addEventListener('input', calc));

  document.getElementById('btn-copy')?.addEventListener('click', copyResult);
  document.getElementById('btn-share')?.addEventListener('click', shareLink);
  document.getElementById('btn-print')?.addEventListener('click', () => window.print());

  hydrateFromParams();
  calc();
})();
</script>

