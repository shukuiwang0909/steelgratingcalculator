---
import Base from "../../../layouts/Base.astro";
import factoriesJson from "../../../data/factories.json";
import { CATEGORIES } from "../../../data/categories";

interface Factory {
  slug: string;
  name: string;
  nameZh?: string;
  tier: "listed" | "verified";
  categories: string[];
  city: string;
  province: string;
  website?: string;
  description: string;
  descriptionZh?: string;
  contact?: { email?: string; phone?: string; whatsapp?: string };
  founded?: number;
  employees?: string;
  exportMarkets?: string[];
  certifications?: string[];
  verifiedNote?: string;
}

export function getStaticPaths() {
  const data = factoriesJson as unknown as Factory[];
  return data.map((factory) => ({
    params: { slug: factory.slug },
    props: {
      factory,
      forceTranslation: {
        en: `/factories/${factory.slug}/`,
        zh: `/zh/factories/${factory.slug}/`,
      },
    },
  }));
}

const { factory, forceTranslation } = Astro.props;
const origin = Astro.site?.origin ?? "https://steelgratingcalculator.com";
const lang = "zh";

const labelFor = (key: string) => CATEGORIES.find((c) => c.key === key)?.zh ?? key;
const primaryCategory = factory.categories[0];
const inquiryUrl = `/zh/inquiry/?factory=${factory.slug}${primaryCategory ? `&category=${primaryCategory}` : ""}`;

const orgJson = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: factory.name,
  alternateName: factory.nameZh,
  url: `${origin}/zh/factories/${factory.slug}/`,
  ...(factory.website ? { sameAs: factory.website } : {}),
  description: factory.descriptionZh || factory.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: factory.city,
    addressRegion: factory.province,
    addressCountry: "CN",
  },
  ...(factory.founded ? { foundingDate: String(factory.founded) } : {}),
};

const infoRows: [string, string][] = [
  ["所在地", `${factory.city}，${factory.province}，中国`],
  ...(factory.founded ? [["成立年份", String(factory.founded)] as [string, string]] : []),
  ...(factory.employees ? [["员工规模", factory.employees] as [string, string]] : []),
  ...(factory.exportMarkets?.length ? [["出口市场", factory.exportMarkets.join("、")] as [string, string]] : []),
  ...(factory.certifications?.length ? [["认证", factory.certifications.join("、")] as [string, string]] : []),
];
---
<Base
  title={`${factory.nameZh || factory.name} — 安平丝网工厂`}
  description={factory.descriptionZh || factory.description}
  {lang}
  forceTranslation={forceTranslation}
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-theme-secondary mb-6">
      <a href="/zh/" class="hover:text-theme-primary">首页</a>
      <span class="mx-2">›</span>
      <a href="/zh/factories/" class="hover:text-theme-primary">工厂目录</a>
      <span class="mx-2">›</span>
      <span>{factory.nameZh || factory.name}</span>
    </nav>

    <div class="flex items-start gap-3 flex-wrap">
      <h1 class="text-3xl md:text-4xl font-bold text-theme-primary">{factory.nameZh || factory.name}</h1>
      {factory.tier === "verified" && (
        <span class="mt-2 shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full accent-bg on-accent">已认证</span>
      )}
    </div>
    {factory.nameZh && <p class="text-theme-muted mt-1">{factory.name}</p>}

    <p class="text-theme-secondary text-lg mt-4 leading-relaxed">{factory.descriptionZh || factory.description}</p>

    <div class="mt-6 bg-theme-card border border-theme rounded-xl p-6">
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
        {infoRows.map(([k, v]) => (
          <div class="flex justify-between gap-4 border-b border-theme pb-2">
            <span class="text-theme-muted">{k}</span>
            <span class="text-theme-primary text-right">{v}</span>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-2 mt-4">
        {factory.categories.map((c) => (
          <a href={`/zh/factories/?category=${c}`} class="text-xs px-2 py-0.5 rounded-full bg-theme-secondary border border-theme text-theme-secondary hover:text-theme-primary transition-colors">{labelFor(c)}</a>
        ))}
      </div>
    </div>

    {factory.tier === "verified" && factory.contact && (
      <div class="mt-6 bg-theme-card border border-accent rounded-xl p-6">
        <p class="font-bold text-theme-primary mb-1">已认证联系方式 <span class="accent-text">✓</span></p>
        {factory.verifiedNote && <p class="text-xs text-theme-muted mb-4">{factory.verifiedNote}</p>}
        <ul class="space-y-2 text-sm">
          {factory.contact.email && (
            <li class="flex justify-between gap-4"><span class="text-theme-muted">邮箱</span><a href={`mailto:${factory.contact.email}`} class="text-theme-primary underline hover:text-theme-accent">{factory.contact.email}</a></li>
          )}
          {factory.contact.phone && (
            <li class="flex justify-between gap-4"><span class="text-theme-muted">电话</span><a href={`tel:${factory.contact.phone.replace(/\s/g, "")}`} class="text-theme-primary underline">{factory.contact.phone}</a></li>
          )}
          {factory.contact.whatsapp && (
            <li class="flex justify-between gap-4"><span class="text-theme-muted">WhatsApp</span><a href={`https://wa.me/${factory.contact.whatsapp.replace(/[^\d]/g, "")}`} class="text-theme-primary underline">+{factory.contact.whatsapp.replace(/[^\d]/g, "")}</a></li>
          )}
        </ul>
      </div>
    )}

    {factory.tier === "listed" && (
      <p class="mt-6 text-sm text-theme-muted bg-theme-secondary bg-opacity-10 border border-theme rounded-lg p-4">
        本页为免费<strong class="text-theme-secondary">收录</strong>资料——联系方式未公开。
        通过下方询盘提交需求，将直接送达该工厂。
      </p>
    )}

    <div class="mt-8 bg-theme-secondary bg-opacity-10 border border-theme rounded-lg p-8 text-center">
      <p class="text-2xl font-bold text-theme-primary mb-4">联系 {factory.nameZh || factory.name}</p>
      <p class="text-theme-secondary mb-6 max-w-2xl mx-auto">
        一次提交您的规格需求——工厂直接回复您，重量与镀层书面写明。免费，24小时内回复。
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={inquiryUrl} class="inline-block px-8 py-3 accent-bg font-semibold rounded-lg hover:opacity-90 transition on-accent">
          提交询盘
        </a>
        {factory.website && (
          <a href={`/go/${factory.slug}/`} class="inline-block px-8 py-3 bg-theme-card border border-theme text-theme-primary font-semibold rounded-lg hover:bg-theme transition">
            访问工厂官网 ↗
          </a>
        )}
      </div>
      {factory.website && <p class="text-xs text-theme-muted mt-3">官网链接带点击追踪，用于向我们证明收录价值。</p>}
    </div>

    <p class="mt-6 text-xs text-theme-muted">
      SteelGratingCalculator 仅收录工厂信息，不对产品认证或担保交易。付款前请自行核验供应商。
    </p>

    <script type="application/ld+json" set:html={JSON.stringify(orgJson)} />
  </div>
</Base>
