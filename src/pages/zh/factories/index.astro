---
import Base from "../../../layouts/Base.astro";
import factoriesJson from "../../../data/factories.json";

const title = "安平钢格栅与金属网工厂目录 | SteelGratingCalculator";
const description = "安平县直供工厂目录——中国最大钢格栅与金属网生产基地。浏览钢格栅、钢板网、丝网等品类的认证工厂，直接联系生产商，无贸易商加价。";

interface Factory {
  slug: string;
  name: string;
  nameZh?: string;
  tier: "listed" | "verified";
  categories: string[];
  city: string;
  province: string;
  website?: string;
  description: string;
  descriptionZh?: string;
  founded?: number;
  employees?: string;
}

const factories = factoriesJson as unknown as Factory[];

const CATEGORY_ZH: Record<string, string> = {
  "plain-steel-grating": "普通钢格栅",
  "serrated-steel-grating": "防滑钢格栅",
  "galvanized-grating": "热镀锌格栅",
  "stainless-steel-grating": "不锈钢格栅",
  "aluminum-grating": "铝合金格栅",
  "stair-treads": "格栅踏步板",
  "trench-covers": "排水沟盖板",
  "heavy-duty-grating": "重型钢格栅",
  "wire-mesh-fence-panels": "护栏网",
  "expanded-metal": "钢板网/扩张网",
  "perforated-metal": "冲孔网",
  "gabion-baskets": "石笼网",
  "noise-barriers": "声屏障",
  "stainless-steel-wire-mesh": "不锈钢丝网",
  "specialty-metal-mesh": "特种金属网",
};

function labelFor(key: string): string {
  return CATEGORY_ZH[key] ?? key.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
---
<Base title={title} description={description} lang="zh">

  <section class="max-w-6xl mx-auto px-4 py-10">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/zh/" class="hover:text-theme-primary transition-colors">首页</a>
      <span>/</span>
      <span class="accent-text">工厂目录</span>
    </nav>

    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-theme accent-border accent-text text-xs font-mono uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full accent-bg"></span>
        中国 · 河北 · 安平县
      </div>
      <h1 class="text-3xl font-semibold text-theme-primary mb-3">安平工厂目录</h1>
      <p class="text-theme-secondary max-w-2xl leading-relaxed">
        直接来自安平县的生产商资料——中国最大的钢格栅与金属网产地。浏览钢格栅、金属网、钢板网等品类工厂，直连生产商，省去贸易商中间差价。
      </p>
    </div>

    <!-- 数据统计 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      {[
        { stat: String(factories.length), label: "已收录工厂" },
        { stat: "1,700+", label: "安平金属企业总数" },
        { stat: "80+", label: "出口目的地国家" },
        { stat: "FOB", label: "工厂直接定价" },
      ].map((s) => (
        <div class="card text-center">
          <p class="text-2xl font-bold accent-text font-mono">{s.stat}</p>
          <p class="text-xs text-theme-muted mt-1">{s.label}</p>
        </div>
      ))}
    </div>

    <!-- 工厂列表 -->
    <div class="grid md:grid-cols-2 gap-5">
      {factories.map((f) => (
        <a href={`/zh/factories/${f.slug}/`} class="card card-accent group flex flex-col gap-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1">
              <h2 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors leading-snug">
                {f.nameZh ?? f.name}
              </h2>
              <p class="text-xs text-theme-muted mt-0.5">{f.name}</p>
            </div>
            <div class="flex flex-col items-end gap-1 shrink-0">
              {f.tier === "verified" && (
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full accent-bg on-accent">已认证 ✓</span>
              )}
              <span class="text-xs text-theme-muted">{f.city}，{f.province}</span>
            </div>
          </div>
          <p class="text-sm text-theme-secondary leading-relaxed flex-1">
            {f.descriptionZh ?? f.description}
          </p>
          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-theme">
            {f.categories.map((c) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-theme-secondary border border-theme text-theme-muted">{labelFor(c)}</span>
            ))}
            {f.founded && <span class="text-xs px-2 py-0.5 rounded-full bg-theme-secondary border border-theme text-theme-muted ml-auto">成立 {f.founded}</span>}
          </div>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 p-6 bg-theme-secondary rounded-xl border border-theme">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex-1">
          <h2 class="text-lg font-semibold text-theme-primary mb-1">需要特定规格？</h2>
          <p class="text-sm text-theme-secondary">提供您的技术要求——承重扁钢规格、间距、表面处理、面板尺寸——我们为您匹配合适工厂并报价。</p>
        </div>
        <a href="/zh/inquiry/" class="accent-bg on-accent px-6 py-3 rounded-lg font-semibold text-sm hover:opacity-90 transition-opacity shrink-0">
          发送询价 →
        </a>
      </div>
    </div>

    <div class="mt-8 text-xs text-theme-muted text-center">
      工厂数量持续更新中。<a href="/zh/inquiry/" class="accent-text hover:opacity-80">联系我们</a>申请收录您的工厂。
    </div>

  </section>

</Base>
