---
import Base from "../layouts/Base.astro";
import FaqJsonLd from "../components/FaqJsonLd.astro";

const title = "Anping Steel Grating Manufacturer Hub — Source Direct from China | SteelGratingCalculator";
const description = "Anping County, Hebei is China's largest steel grating manufacturing hub with 1,700+ factories. Learn why engineers and buyers worldwide source plain, galvanized, and stainless grating from Anping.";

const faqs = [
  ["Why is Anping famous for steel grating?", "Anping has a 500-year history of metalworking. Today it hosts over 1,700 metal product factories, with specialized clusters for steel grating, wire mesh, expanded metal, and perforated plate. The concentration of suppliers, raw material processors, and galvanizing plants makes it impossible to beat on price."],
  ["Can Anping factories make custom sizes?", "Yes. Most factories can produce non-standard panel sizes, custom bearing bar heights, custom pitches, and fabricated assemblies like stair treads, trench covers, and structural frames."],
  ["What is the lead time for steel grating from Anping?", "Standard sizes are often in stock (1–3 days). Custom production takes 7–15 days. Shipping time from Tianjin Port to Europe is 25–35 days; to US West Coast 18–25 days; to Middle East 15–20 days."],
  ["Do Anping factories hold quality certifications?", "Many hold ISO 9001. Major exporters also carry SGS test reports, CE declarations, and can supply MTRs (material test records) on request. Always ask for a factory audit report or third-party inspection before large orders."],
  ["What is the MOQ for steel grating from Anping?", "Most factories accept 1-tonne MOQ for standard specs. Custom fabrications may require 3–5 tonnes. Some trading companies accept sample orders of 5–10 panels."],
];
---
<Base title={title} description={description} lang="en">

  <section class="max-w-5xl mx-auto px-4 py-12">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-theme-primary transition-colors">Home</a>
      <span>/</span>
      <span class="accent-text">Anping Steel Grating Hub</span>
    </nav>

    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-theme accent-border accent-text text-xs font-mono uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full accent-bg"></span>
        Anping, Hebei, China
      </div>
      <h1 class="text-4xl font-semibold text-theme-primary mb-4">The Steel Grating Capital of China</h1>
      <p class="text-theme-secondary text-lg leading-relaxed max-w-3xl">
        Anping County in Hebei Province is China's largest steel grating manufacturing hub — and the world's most competitive source for industrial bar grating. Over 1,700 metal product enterprises produce the full spectrum of steel grating products for export to 80+ countries.
      </p>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      {[
        { stat: "1,700+", label: "Metal product enterprises" },
        { stat: "80+", label: "Export destination countries" },
        { stat: "500 yrs", label: "Metalworking heritage" },
        { stat: "3M t/yr", label: "Steel mesh & grating output" },
      ].map((s) => (
        <div class="card text-center">
          <p class="text-2xl font-bold accent-text font-mono">{s.stat}</p>
          <p class="text-xs text-theme-muted mt-1">{s.label}</p>
        </div>
      ))}
    </div>

    <!-- Why Anping section -->
    <div class="prose max-w-none text-theme-secondary leading-relaxed mb-12 space-y-6">
      <h2 class="text-2xl font-semibold text-theme-primary">Why Engineers and Buyers Source Grating from Anping</h2>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="card">
          <h3 class="font-semibold text-theme-primary mb-2">Unbeatable Price Competitiveness</h3>
          <p class="text-sm text-theme-secondary">The industrial cluster creates intense price competition among hundreds of grating factories within a 30km radius. Raw steel, galvanizing services, and fabrication are all available locally — eliminating long logistics chains and keeping FOB prices 30–50% below equivalent Western-manufactured grating.</p>
        </div>
        <div class="card">
          <h3 class="font-semibold text-theme-primary mb-2">Deep Technical Capability</h3>
          <p class="text-sm text-theme-secondary">Factories in Anping have refined the welded bar grating process over decades. Most can produce bearing bars from 20×3mm up to 75×10mm, in pitches from 11mm to 76mm, with custom cross bar configurations. Many hold NAAMM, BS 4592, and AS/NZS 1576 compliance capability.</p>
        </div>
        <div class="card">
          <h3 class="font-semibold text-theme-primary mb-2">Full Product Spectrum</h3>
          <p class="text-sm text-theme-secondary">From plain welded grating to serrated anti-slip panels, hot-dip galvanized grating (610 g/m² coating), stainless steel 304/316, aluminum 6061-T6, stair treads, trench covers, and custom fabricated frames — one shipment can cover multiple product types from one port.</p>
        </div>
        <div class="card">
          <h3 class="font-semibold text-theme-primary mb-2">Galvanizing Infrastructure</h3>
          <p class="text-sm text-theme-secondary">Anping hosts numerous hot-dip galvanizing plants that service the local grating factories. This means finished grating panels can be galvanized on-site before packing — faster than regions where galvanizing requires a separate logistics step.</p>
        </div>
      </div>

      <h2 class="text-2xl font-semibold text-theme-primary mt-10">Product Categories Available from Anping</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {[
          ["Plain Steel Bar Grating", "Standard welded grating in carbon steel. The most common export product, available in all standard pitches."],
          ["Serrated Steel Grating", "Anti-slip notched top edge (teeth) for safety-critical applications. Available in all standard sizes."],
          ["Hot-Dip Galvanized Grating", "Zinc-coated per ISO 1461 (610 g/m²). Most common surface treatment for outdoor and corrosive environments."],
          ["Stainless Steel Grating", "Grade 304 and 316L. For food processing, pharmaceuticals, marine, and chemical plants."],
          ["Aluminum Bar Grating", "6061-T6 alloy. Lightweight, non-sparking, corrosion resistant. For offshore, marine, and clean environments."],
          ["Grating Stair Treads", "Cut-to-size panels with checkered plate nosing band. Standard and custom dimensions."],
          ["Trench Covers & Drain Grates", "Custom-width drainage grating with optional frame. Load-rated options available."],
          ["Heavy Duty Grating", "50–75mm bearing bars for vehicle loading and heavy industrial floors."],
        ].map(([name, desc]) => (
          <div class="flex gap-3 p-3 bg-theme-tertiary rounded-lg border border-theme">
            <span class="w-1.5 h-1.5 rounded-full accent-bg mt-1.5 shrink-0"></span>
            <div>
              <p class="font-semibold text-theme-primary text-sm">{name}</p>
              <p class="text-xs text-theme-secondary mt-0.5">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA + cross link -->
    <div class="grid md:grid-cols-2 gap-4 mb-12">
      <div class="card card-accent text-center p-8">
        <h3 class="font-semibold text-lg text-theme-primary mb-2">Calculate Your Specification</h3>
        <p class="text-sm text-theme-secondary mb-4">Use our free tools to verify weight, load capacity, and open area before sending an inquiry.</p>
        <a href="/tools/steel-grating-weight-calculator/" class="inline-flex items-center gap-2 accent-bg hover:opacity-90 font-semibold px-6 py-3 rounded-lg transition-opacity on-accent text-sm">
          Open Weight Calculator →
        </a>
      </div>
      <div class="card text-center p-8 border border-theme">
        <h3 class="font-semibold text-lg text-theme-primary mb-2">Also Sourcing Wire Mesh?</h3>
        <p class="text-sm text-theme-secondary mb-4">Anping is also China's wire mesh capital. Calculate welded and woven wire mesh weight on our sister site.</p>
        <a href="https://meshcalculator.com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-theme hover:accent-border font-semibold px-6 py-3 rounded-lg transition-colors text-sm text-theme-primary hover:accent-text">
          MeshCalculator.com →
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <FaqJsonLd items={faqs.map(([q, a]) => ({ question: q, answer: a }))} inLanguage="en" />
    <h2 class="text-2xl font-semibold text-theme-primary mb-6">Frequently Asked Questions</h2>
    <div class="space-y-3 mb-12">
      {faqs.map(([q, a]) => (
        <details class="card group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="font-medium text-theme-primary">{q}</span>
            <svg class="w-5 h-5 text-theme-muted shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <p class="mt-3 text-sm text-theme-secondary leading-relaxed">{a}</p>
        </details>
      ))}
    </div>

    <!-- Final CTA -->
    <div class="card card-accent relative overflow-hidden text-center py-12">
      <div class="absolute inset-0 bg-gradient-to-br from-theme-tertiary via-transparent to-transparent"></div>
      <div class="relative">
        <h2 class="text-2xl font-semibold text-theme-primary mb-3">Ready to Source Steel Grating from Anping?</h2>
        <p class="text-theme-secondary mb-6 max-w-lg mx-auto">Send your specification to matched factories. No middlemen, no trading company markups.</p>
        <a href="/inquiry/" class="inline-flex items-center gap-2 accent-bg hover:opacity-90 font-semibold px-8 py-4 rounded-lg transition-all on-accent">
          Send an Inquiry
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>

  </section>

</Base>
