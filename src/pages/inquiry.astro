---
import Base from "../layouts/Base.astro";

const products = [
  "Plain Steel Bar Grating",
  "Serrated Steel Bar Grating",
  "Hot-Dip Galvanized Grating",
  "Stainless Steel Grating (304)",
  "Stainless Steel Grating (316L)",
  "Aluminum Bar Grating",
  "Grating Stair Treads",
  "Trench Covers & Drain Grates",
  "Heavy Duty Steel Grating",
  "Other / Multiple Products",
];

const categoryToProduct: Record<string, string> = {
  "plain-steel-grating": "Plain Steel Bar Grating",
  "serrated-steel-grating": "Serrated Steel Bar Grating",
  "galvanized-grating": "Hot-Dip Galvanized Grating",
  "stainless-steel-grating": "Stainless Steel Grating (304)",
  "aluminum-grating": "Aluminum Bar Grating",
  "stair-treads": "Grating Stair Treads",
  "trench-covers": "Trench Covers & Drain Grates",
  "heavy-duty-grating": "Heavy Duty Steel Grating",
};

const input = "w-full border border-theme rounded-lg px-3 py-2 bg-theme-card text-theme-primary";
const label = "block text-sm font-semibold mb-1 text-theme-primary";
---

<Base title="Send a Steel Grating Inquiry — Get Quotes from Anping Factories" description="One structured inquiry, sent directly to matching Anping steel grating factories. No middlemen, no trading company markups. Free for buyers.">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <div class="mb-6">
      <h1 class="text-3xl font-semibold text-theme-primary">Send a Steel Grating Inquiry</h1>
      <p class="mt-2 text-theme-secondary">Fill in your specification — we forward it to matching Anping factories. Factories reply to you directly. Free for buyers, no middlemen.</p>
      <p class="mt-3 text-sm text-theme-muted">
        Prefer email? <a href="mailto:inquiry@steelgratingcalculator.com" class="underline hover:text-theme-primary">inquiry@steelgratingcalculator.com</a> — same inbox, we reply within 24 hours.
      </p>
    </div>

    <form class="bg-theme-card border border-theme rounded-xl p-6 space-y-7" name="inquiry" method="POST" action="https://formspree.io/f/mbgljvar">
      <input type="hidden" name="_subject" value="New steel grating inquiry — steelgratingcalculator.com" />
      <input type="hidden" name="_next" value="https://steelgratingcalculator.com/inquiry/thanks/" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <!-- ① Product Spec -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">① Product Specification</legend>
        <div>
          <label class={label} for="product">Product Type</label>
          <select id="product" name="product" class={input} required>
            <option value="">Select…</option>
            {products.map(p => <option>{p}</option>)}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="bearing_bar_spec">Bearing Bar Spec</label>
            <input id="bearing_bar_spec" name="bearing_bar_spec" type="text" class={input} placeholder="e.g. 25×5mm @ 30mm pitch" />
          </div>
          <div>
            <label class={label} for="cross_bar_spec">Cross Bar Spec</label>
            <input id="cross_bar_spec" name="cross_bar_spec" type="text" class={input} placeholder="e.g. 6mm round @ 50mm pitch" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="panel_size">Panel Size</label>
            <input id="panel_size" name="panel_size" type="text" class={input} placeholder="e.g. 6000×1000mm" />
          </div>
          <div>
            <label class={label} for="surface_finish">Surface Finish</label>
            <select id="surface_finish" name="surface_finish" class={input}>
              <option value="">Select…</option>
              <option>Plain Black (oiled)</option>
              <option>Hot-Dip Galvanized</option>
              <option>Painted</option>
              <option>Stainless (as specified)</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div>
          <label class={label} for="quantity">Quantity <span class="text-theme-muted font-normal">(+ unit)</span></label>
          <input id="quantity" name="quantity" type="text" class={input} placeholder="e.g. 500 m² / 80 panels / 3 tonnes" />
        </div>
        <div>
          <label class={label} for="message">Notes / Drawing Reference <span class="text-theme-muted font-normal">(optional)</span></label>
          <textarea id="message" name="message" rows="3" class={input} placeholder="Application, tolerance, certificates needed, drawings, NAAMM/BS 4592 spec requirements…"></textarea>
        </div>
      </fieldset>

      <!-- ② Trade Terms -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">② Trade & Destination</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="trade_term">Trade Term</label>
            <select id="trade_term" name="trade_term" class={input}>
              <option value="">Select…</option>
              <option>FOB</option><option>CIF</option><option>CFR</option>
              <option>EXW</option><option>DAP / DDP</option>
              <option>Not sure — advise me</option>
            </select>
          </div>
          <div>
            <label class={label} for="destination_port">Destination Port / City</label>
            <input id="destination_port" name="destination_port" type="text" class={input} placeholder="e.g. Hamburg, Los Angeles, Jebel Ali" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="target_price">Target Price <span class="text-theme-muted font-normal">(optional)</span></label>
            <input id="target_price" name="target_price" type="text" class={input} placeholder="e.g. USD 15/m² FOB" />
          </div>
          <div>
            <label class={label} for="timeline">Purchase Timeline</label>
            <select id="timeline" name="timeline" class={input}>
              <option value="">Select…</option>
              <option>Immediately</option><option>Within 1 month</option>
              <option>1–3 months</option><option>3+ months / researching</option>
            </select>
          </div>
        </div>
      </fieldset>

      <!-- ③ Contact -->
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold text-theme-primary uppercase tracking-wide mb-3">③ Your Contact</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="name">Your Name</label>
            <input id="name" name="name" type="text" required class={input} />
          </div>
          <div>
            <label class={label} for="email">Work Email</label>
            <input id="email" name="email" type="email" required class={input} placeholder="name@company.com" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="company">Company</label>
            <input id="company" name="company" type="text" required class={input} />
          </div>
          <div>
            <label class={label} for="website">Company Website <span class="text-theme-muted font-normal">(optional)</span></label>
            <input id="website" name="website" type="url" class={input} placeholder="https://…" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="whatsapp">WhatsApp <span class="text-theme-muted font-normal">(optional)</span></label>
            <input id="whatsapp" name="whatsapp" type="tel" class={input} placeholder="+1 …" />
          </div>
          <div>
            <label class={label} for="country">Country</label>
            <input id="country" name="country" type="text" required class={input} />
          </div>
        </div>
      </fieldset>

      <button type="submit" class="w-full accent-bg hover:opacity-90 on-accent font-semibold py-3 rounded-lg transition-opacity">Send to Matching Factories</button>
      <p class="text-xs text-theme-muted">By submitting you agree to our <a href="/terms/" class="underline">Terms</a> and <a href="/privacy/" class="underline">Privacy Policy</a>. We never sell buyer data.</p>
    </form>
  </section>

  <script id="cat-map" type="application/json" set:html={JSON.stringify(categoryToProduct)} />
  <script is:inline>
    (function () {
      var catMap = {};
      try { catMap = JSON.parse(document.getElementById("cat-map").textContent); } catch (e) {}
      var params = new URLSearchParams(location.search);
      var cat = params.get("category");
      var bbSpec = params.get("bb_spec");
      var panel = params.get("panel");
      var qty = params.get("qty");

      if (cat && catMap[cat]) {
        var sel = document.getElementById("product");
        if (sel) {
          var opts = sel.options;
          for (var i = 0; i < opts.length; i++) {
            if (opts[i].text === catMap[cat]) { sel.selectedIndex = i; break; }
          }
        }
      }
      if (bbSpec) {
        var bb = document.getElementById("bearing_bar_spec");
        if (bb) bb.value = decodeURIComponent(bbSpec);
      }
      if (panel) {
        var ps = document.getElementById("panel_size");
        if (ps) ps.value = decodeURIComponent(panel);
      }
      if (qty) {
        var q = document.getElementById("quantity");
        if (q) q.value = qty + " panels";
      }
    })();
  </script>
</Base>
