---
import Base from "../layouts/Base.astro";
---
<Base title="Page Not Found | MeshCalculator">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-4xl font-extrabold">404</h1>
    <p class="mt-4 text-theme-secondary">This page doesn't exist. Try one of our tools:</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/tools/woven-wire-mesh-weight-calculator/" class="bg-theme-secondary text-white px-5 py-2.5 rounded-lg text-sm hover:bg-theme-tertiary transition-colors">Weight calculator</a>
      <a href="/charts/mesh-size-chart/" class="bg-theme-secondary text-white px-5 py-2.5 rounded-lg text-sm hover:bg-theme-tertiary transition-colors">Size chart</a>
      <a href="/" class="border border-theme px-5 py-2.5 rounded-lg text-sm hover:border-accent-400 transition-colors">Home</a>
    </div>
  </section>
</Base>
