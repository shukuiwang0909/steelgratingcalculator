---
import Base from "../../layouts/Base.astro";
import FaqJsonLd from "../../components/FaqJsonLd.astro";

const faqs = [
  ["What load capacity is required for industrial flooring?", "Most industrial facilities require floors rated for 5–15 kPa UDL (100–300 psf) depending on the application. Forklift traffic may impose 20–50 kN wheel loads. Use the load capacity calculator with your specific span and bearing bar to verify."],
  ["What bearing bar specification is most common for industrial floors?", "25×5mm @ 30mm pitch is the most common spec for general industrial use. Heavier spans or vehicle traffic may require 40×5mm or 50×5mm @ 22mm pitch."],
  ["Does industrial grating flooring meet fire rating requirements?", "Steel bar grating is a non-combustible material. However, grating flooring does not typically provide a fire-rated floor assembly on its own. For fire-rated applications, a solid infill or fire-rated decking system is normally required."],
];
---

<Base title="Steel Grating for Industrial Flooring — Load Ratings, Specifications | Anping" description="Steel bar grating for industrial mezzanine and plant floors. Load capacity, NAAMM and BS 4592 classes, specification guide for process plants, factories, and warehouses.">

  <article class="max-w-4xl mx-auto px-4 py-10">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-theme-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/applications/" class="hover:text-theme-primary transition-colors">Applications</a>
      <span>/</span>
      <span class="accent-text">Industrial Flooring</span>
    </nav>

    <div class="mb-8">
      <span class="text-xs font-mono accent-text uppercase tracking-wider">Application Guide</span>
      <h1 class="text-4xl font-semibold text-theme-primary leading-tight mt-2 mb-4">Steel Grating for Industrial Flooring</h1>
      <p class="text-lg text-theme-secondary leading-relaxed">Bar grating is the industry standard for mezzanine floors, process plant platforms, and factory maintenance walkways. Open surface provides natural drainage and ventilation while meeting structural load requirements.</p>
    </div>

    <div class="mb-8 p-4 bg-theme-tertiary rounded-xl border border-theme flex items-center gap-4">
      <div class="flex-1">
        <p class="text-sm font-medium text-theme-primary">Verify your specification</p>
        <p class="text-xs text-theme-muted">Check load capacity and calculate total order weight before sending an inquiry.</p>
      </div>
      <div class="flex gap-2 shrink-0">
        <a href="/tools/bar-grating-load-capacity-calculator/" class="text-sm accent-text font-semibold hover:opacity-80 transition-opacity whitespace-nowrap">Load Calc →</a>
        <a href="/tools/steel-grating-weight-calculator/" class="text-sm text-theme-secondary hover:text-theme-primary font-semibold transition-colors whitespace-nowrap">Weight Calc →</a>
      </div>
    </div>

    <div class="prose max-w-none text-theme-secondary leading-relaxed space-y-8">

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Why Steel Grating for Industrial Floors?</h2>
        <ul class="list-disc pl-6 space-y-2 mt-2">
          <li><strong class="text-theme-primary">Natural drainage</strong> — spilled liquids drain through without pooling, reducing slip hazard</li>
          <li><strong class="text-theme-primary">Ventilation</strong> — open surface allows hot air, fumes, and dust to pass through; critical in furnace areas and chemical plants</li>
          <li><strong class="text-theme-primary">Weight savings</strong> — 30–50% lighter than steel plate flooring, reducing structural steel cost</li>
          <li><strong class="text-theme-primary">Visibility</strong> — maintenance staff can see equipment and services below the floor level</li>
          <li><strong class="text-theme-primary">Speed of installation</strong> — pre-fabricated panels drop into support framing; no welding required</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Typical Specification by Industry</h2>
        <div class="overflow-x-auto mt-3">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-theme"><th class="text-left py-2 pr-4 text-theme-muted font-medium">Industry</th><th class="text-left py-2 pr-4 text-theme-muted font-medium">Typical Spec</th><th class="text-left py-2 text-theme-muted font-medium">Surface Finish</th></tr></thead>
            <tbody class="text-theme-secondary">
              {[
                ["General factory / warehouse", "25×5mm @ 30mm, plain", "Black or galvanized"],
                ["Process chemical plant", "25×5mm @ 30mm, serrated", "Galvanized or SS 316"],
                ["Food processing", "25×5mm @ 30mm, serrated", "SS 304 or SS 316"],
                ["Steel / metals plant", "40×5mm @ 22mm, serrated", "Plain black"],
                ["Power station", "40×5mm @ 30mm, plain", "Galvanized"],
                ["Offshore platform", "25×5mm @ 30mm, serrated", "Hot-dip galvanized"],
              ].map(([ind, spec, fin]) => (
                <tr class="border-b border-theme/50">
                  <td class="py-2 pr-4 font-medium text-theme-primary">{ind}</td>
                  <td class="py-2 pr-4 font-mono text-sm">{spec}</td>
                  <td class="py-2">{fin}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Span & Load Class Reference</h2>
        <p>Select bearing bar depth based on the clear span (support to support) and design load. General guideline:</p>
        <ul class="list-disc pl-6 space-y-1 mt-2 text-sm">
          <li>Span ≤ 600mm: 25mm bearing bars adequate for most industrial loads</li>
          <li>Span 600–1000mm: 30–40mm bars for typical 5 kPa design load</li>
          <li>Span 1000–1500mm: 40–50mm bars; verify with load calculator</li>
          <li>Span > 1500mm: 50–65mm bars; consult structural engineer</li>
        </ul>
        <div class="mt-4">
          <a href="/tools/bar-grating-load-capacity-calculator/" class="accent-bg hover:opacity-90 on-accent text-sm font-semibold px-4 py-2 rounded-lg transition-opacity">Use Load Calculator</a>
        </div>
      </section>

    </div>

    <FaqJsonLd items={faqs.map(([q, a]) => ({ question: q, answer: a }))} inLanguage="en" />
    <div class="mt-10 pt-8 border-t border-theme">
      <h2 class="text-xl font-semibold text-theme-primary mb-5">FAQs</h2>
      <div class="space-y-3">
        {faqs.map(([q, a]) => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium text-theme-primary">{q}</span>
              <svg class="w-5 h-5 text-theme-muted shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-sm text-theme-secondary leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-theme">
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/applications/walkways-platforms/" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">Application</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">Walkways & Platforms →</h3>
        </a>
        <a href="/inquiry/" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">Get Quote</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">Request Flooring Grating</h3>
        </a>
      </div>
    </div>

  </article>

</Base>
