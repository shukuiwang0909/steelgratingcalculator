---
import Base from "../../layouts/Base.astro";
import FaqJsonLd from "../../components/FaqJsonLd.astro";

const faqs = [
  ["What is the minimum width for an industrial walkway?", "OSHA 1910.28 requires a minimum clear width of 22 inches (558mm) for walkways. Most industrial platforms are 600–1200mm wide. For two-person passing clearance, 1000mm is the practical minimum."],
  ["Does grating width affect the required bearing bar spec?", "Walkway width affects panel span only if the bearing bars run across the width (perpendicular to traffic). If the long axis of the bearing bars runs along the walkway, span is the distance between cross-supports, not the walkway width."],
  ["What is the standard maximum opening size for walkway grating?", "OSHA 1910.28 requires openings no larger than 1 inch (25mm) in the least dimension. Standard 25×5mm @ 30mm grating with 6mm round cross bar @ 50mm pitch typically produces opening sizes of 25mm × 44mm — the 25mm dimension is compliant."],
];
---

<Base title="Steel Grating for Walkways & Elevated Platforms — Safety & Spec Guide | Anping" description="Steel bar grating for industrial walkways, elevated platforms, and access bridges. OSHA minimum opening sizes, width requirements, and anti-slip specification guide.">

  <article class="max-w-4xl mx-auto px-4 py-10">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-theme-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/applications/" class="hover:text-theme-primary transition-colors">Applications</a>
      <span>/</span>
      <span class="accent-text">Walkways & Platforms</span>
    </nav>

    <div class="mb-8">
      <span class="text-xs font-mono accent-text uppercase tracking-wider">Application Guide</span>
      <h1 class="text-4xl font-semibold text-theme-primary leading-tight mt-2 mb-4">Steel Grating for Walkways & Elevated Platforms</h1>
      <p class="text-lg text-theme-secondary leading-relaxed">Industrial access walkways, process plant catwalks, and elevated maintenance platforms. Open bar construction reduces wind load on tall structures and provides natural drainage.</p>
    </div>

    <div class="prose max-w-none text-theme-secondary leading-relaxed space-y-8">

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Design Requirements</h2>
        <div class="overflow-x-auto mt-3">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-theme"><th class="text-left py-2 pr-4 text-theme-muted font-medium">Parameter</th><th class="text-left py-2 text-theme-muted font-medium">Requirement / Typical</th></tr></thead>
            <tbody class="text-theme-secondary">
              {[
                ["Minimum clear width (OSHA)", "22 in / 558 mm"],
                ["Max opening size (OSHA 1910.28)", "1 in / 25.4 mm least dimension"],
                ["Live load (NAAMM walkway)", "100 psf / 4.8 kPa minimum"],
                ["Deflection limit (NAAMM MBG 531)", "L/180 under live load"],
                ["Surface", "Plain (indoor, dry) or serrated (outdoor, wet)"],
                ["Guard rail height (OSHA)", "42 in / 1067 mm top rail"],
              ].map(([p, v]) => (
                <tr class="border-b border-theme/50">
                  <td class="py-2 pr-4 font-medium text-theme-primary">{p}</td>
                  <td class="py-2">{v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Wind Load Advantage</h2>
        <p>Elevated platforms on process plant structures and offshore installations benefit significantly from grating's open surface. A typical 30mm pitch grating has 60–70% open area, meaning wind exerts roughly 30–40% of the load on an equivalent solid plate. This reduces forces on supporting structure at height.</p>
        <p class="mt-2">Use the <a href="/tools/open-area-percentage-calculator/" class="accent-text underline">open area calculator</a> to confirm the wind load reduction factor for your specification.</p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Typical Specifications</h2>
        <ul class="list-disc pl-6 space-y-2 mt-2 text-sm">
          <li><strong class="text-theme-primary">Process plant catwalks:</strong> 25×5mm @ 30mm serrated, galvanized</li>
          <li><strong class="text-theme-primary">Petrochemical access bridges:</strong> 25×5mm or 30×5mm @ 30mm serrated, galvanized</li>
          <li><strong class="text-theme-primary">Building maintenance walkways:</strong> 25×5mm @ 34mm plain, galvanized</li>
          <li><strong class="text-theme-primary">Offshore platforms:</strong> 25×5mm @ 30mm serrated, hot-dip galvanized</li>
          <li><strong class="text-theme-primary">Stainless food plant:</strong> 25×5mm @ 30mm serrated, SS 304</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Panel Arrangement</h2>
        <p>Bearing bars should run perpendicular to the direction of travel (across the walkway width) for maximum structural efficiency. On narrow walkways (< 600mm), bearing bars may run along the length — verify span and load with the calculator.</p>
        <p class="mt-2">Standard panel installation uses clip fasteners (saddle clips) or welded angles. Panels should be removable for maintenance access.</p>
        <div class="mt-4 flex gap-3">
          <a href="/tools/steel-grating-weight-calculator/" class="accent-bg hover:opacity-90 on-accent text-sm font-semibold px-4 py-2 rounded-lg transition-opacity">Calculate Weight</a>
          <a href="/inquiry/" class="border border-theme text-sm font-semibold px-4 py-2 rounded-lg hover:border-theme-primary transition-colors text-theme-primary">Get a Quote</a>
        </div>
      </section>

    </div>

    <FaqJsonLd items={faqs.map(([q, a]) => ({ question: q, answer: a }))} inLanguage="en" />
    <div class="mt-10 pt-8 border-t border-theme">
      <h2 class="text-xl font-semibold text-theme-primary mb-5">FAQs</h2>
      <div class="space-y-3">
        {faqs.map(([q, a]) => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium text-theme-primary">{q}</span>
              <svg class="w-5 h-5 text-theme-muted shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-sm text-theme-secondary leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>

  </article>

</Base>
