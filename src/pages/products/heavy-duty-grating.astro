---
import Base from "../../layouts/Base.astro";
import FaqJsonLd from "../../components/FaqJsonLd.astro";

const faqs = [
  ["What defines 'heavy duty' steel grating?", "There is no single universal threshold, but heavy-duty grating typically refers to panels with bearing bars of 50mm height or greater, and/or pitch of 22mm or less. These can support concentrated loads exceeding 10 kN and distributed loads above 12 kPa over spans of 1–2 m."],
  ["What industries use heavy duty grating?", "Steel mills, mining, power stations, petrochemical refineries, offshore platforms, and heavy manufacturing. Any application with axle or wheel loads from forklifts, vehicles, or heavy equipment."],
  ["Can I calculate the load capacity before ordering?", "Yes. Use our Bar Grating Load Capacity Calculator with your bearing bar size, pitch, and span. For loads exceeding the calculator's standard range, consult a structural engineer."],
  ["What is the maximum bearing bar height available?", "Anping factories typically produce bearing bars up to 100mm × 8mm for special heavy-duty applications. Standard range ends at 75mm × 6mm. Consult directly for non-standard heights."],
];
---

<Base title="Heavy Duty Steel Grating — High-Load Industrial Bar Grating | Anping" description="Heavy duty steel bar grating for mining, steel mills, and industrial vehicle loads. Bearing bars 50–75mm, close pitch. Load capacity calculator. Source from Anping, China.">

  <article class="max-w-4xl mx-auto px-4 py-10">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-theme-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/products/" class="hover:text-theme-primary transition-colors">Products</a>
      <span>/</span>
      <span class="accent-text">Heavy Duty Grating</span>
    </nav>

    <div class="mb-8">
      <span class="text-xs font-mono accent-text uppercase tracking-wider">Product Guide</span>
      <h1 class="text-4xl font-semibold text-theme-primary leading-tight mt-2 mb-4">Heavy Duty Steel Grating</h1>
      <p class="text-lg text-theme-secondary leading-relaxed">High-capacity bar grating for mining operations, steel mills, power stations, and industrial vehicle traffic. Deep bearing bars and close pitch for maximum load-bearing.</p>
    </div>

    <div class="mb-8 p-4 bg-theme-tertiary rounded-xl border border-theme flex items-center gap-4">
      <div class="flex-1">
        <p class="text-sm font-medium text-theme-primary">Verify load capacity for your span</p>
        <p class="text-xs text-theme-muted">Enter bearing bar depth, thickness, pitch, and clear span to check allowable UDL and point load.</p>
      </div>
      <a href="/tools/bar-grating-load-capacity-calculator/" class="text-sm accent-text font-semibold hover:opacity-80 transition-opacity shrink-0 whitespace-nowrap">Load Calculator →</a>
    </div>

    <div class="prose max-w-none text-theme-secondary leading-relaxed space-y-8">

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Common Heavy Duty Specifications</h2>
        <div class="overflow-x-auto mt-3">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-theme"><th class="text-left py-2 pr-4 text-theme-muted font-medium">Bearing Bar</th><th class="text-right py-2 pr-4 text-theme-muted font-medium">Pitch (mm)</th><th class="text-right py-2 pr-4 text-theme-muted font-medium">Weight (kg/m²)</th><th class="text-left py-2 text-theme-muted font-medium">Application</th></tr></thead>
            <tbody class="text-theme-secondary">
              {[
                ["40×5 mm", "22", "63.5", "Forklift traffic, industrial mezzanines"],
                ["50×5 mm", "22", "76.1", "Light vehicle roads, power plant platforms"],
                ["50×6 mm", "22", "91.0", "Medium truck access, heavy platforms"],
                ["65×5 mm", "22", "96.0", "Long-span heavy-duty floors"],
                ["65×6 mm", "22", "114.0", "Mining, steel plant, heavy axle loads"],
                ["75×6 mm", "22", "131.0", "Maximum standard HD specification"],
              ].map(([bb, p, w, u]) => (
                <tr class="border-b border-theme/50">
                  <td class="py-2 pr-4 font-mono font-medium text-theme-primary">{bb}</td>
                  <td class="py-2 pr-4 text-right font-mono">{p}</td>
                  <td class="py-2 pr-4 text-right font-mono accent-text font-semibold">{w}</td>
                  <td class="py-2 text-xs">{u}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-theme-muted mt-2">Weights include 8mm round cross bar at 50mm pitch. Carbon steel (7.85 g/cm³). Use the <a href="/tools/steel-grating-weight-calculator/" class="underline">weight calculator</a> for exact values.</p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Industries</h2>
        <ul class="grid md:grid-cols-2 gap-2 mt-3 text-sm">
          {[
            "Iron & steel mills", "Underground mining",
            "Power generation plants", "Petrochemical refineries",
            "Shipyard dry docks", "Heavy manufacturing",
            "Port & bulk terminal operations", "Cement and aggregate plants"
          ].map(app => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full accent-bg shrink-0"></span>
              <span class="text-theme-secondary">{app}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Specification & Ordering</h2>
        <p>Heavy duty grating is typically ordered to project-specific dimensions. Provide bearing bar size, pitch, panel dimensions, surface finish (black/galvanized), and load class or reference standard in your inquiry. MOQ for non-standard specs: 5–10 tonnes. Lead time 25–40 days.</p>
        <div class="mt-4">
          <a href="/inquiry/?product=heavy-duty-grating" class="accent-bg hover:opacity-90 on-accent text-sm font-semibold px-4 py-2 rounded-lg transition-opacity">Get a Heavy Duty Grating Quote</a>
        </div>
      </section>

    </div>

    <FaqJsonLd items={faqs.map(([q, a]) => ({ question: q, answer: a }))} inLanguage="en" />
    <div class="mt-10 pt-8 border-t border-theme">
      <h2 class="text-xl font-semibold text-theme-primary mb-5">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map(([q, a]) => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium text-theme-primary">{q}</span>
              <svg class="w-5 h-5 text-theme-muted shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-sm text-theme-secondary leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>

  </article>

</Base>
