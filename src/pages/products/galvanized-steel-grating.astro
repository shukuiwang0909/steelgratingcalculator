---
import Base from "../../layouts/Base.astro";
import FaqJsonLd from "../../components/FaqJsonLd.astro";

const faqs = [
  ["What standard is used for hot-dip galvanizing steel grating?", "ISO 1461 is the international standard (equivalent to EN ISO 1461 in Europe, and closely related to ASTM A123 in North America). It specifies minimum zinc coating thickness based on steel thickness — typically 45–85 μm for grating sections."],
  ["How much does galvanizing add to the weight of steel grating?", "Hot-dip galvanizing adds approximately 4% to the bare steel weight. A standard 25×5mm @ 30mm pitch panel at 37.1 kg/m² becomes approximately 38.6 kg/m² after galvanizing."],
  ["Can galvanized steel grating be welded or cut in the field?", "Cutting and re-welding destroys the zinc coating at those points. Damaged areas must be touched up with zinc-rich paint (per ISO 1461 touch-up requirements) or cold galvanizing compound. For this reason, grating is normally cut to final dimensions before galvanizing."],
  ["How long does galvanized steel grating last outdoors?", "Properly hot-dip galvanized grating typically provides 25–40 years of maintenance-free service in standard outdoor environments. In marine or industrial chemical environments, service life may be 15–25 years depending on salt/chemical exposure."],
];
---

<Base title="Hot-Dip Galvanized Steel Grating — ISO 1461, Weight, Corrosion Life | Anping" description="Galvanized steel bar grating: ISO 1461 / ASTM A123 zinc coating, 25–40 year outdoor service life. Specifications, weight calculations, and sourcing from Anping, China.">

  <article class="max-w-4xl mx-auto px-4 py-10">

    <nav class="text-xs text-theme-muted mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-theme-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/products/" class="hover:text-theme-primary transition-colors">Products</a>
      <span>/</span>
      <span class="accent-text">Galvanized Steel Grating</span>
    </nav>

    <div class="mb-8">
      <span class="text-xs font-mono accent-text uppercase tracking-wider">Product Guide</span>
      <h1 class="text-4xl font-semibold text-theme-primary leading-tight mt-2 mb-4">Hot-Dip Galvanized Steel Grating</h1>
      <p class="text-lg text-theme-secondary leading-relaxed">Carbon steel bar grating with ISO 1461 hot-dip zinc coating for outdoor, coastal, and industrial corrosive environments. 25–40 year service life with zero maintenance.</p>
    </div>

    <div class="mb-8 p-4 bg-theme-tertiary rounded-xl border border-theme flex items-center gap-4">
      <div class="flex-1">
        <p class="text-sm font-medium text-theme-primary">Weight includes galvanizing (+4%)</p>
        <p class="text-xs text-theme-muted">Use the calculator and check the "Hot-Dip Galvanized" toggle for actual shipping weight.</p>
      </div>
      <a href="/tools/steel-grating-weight-calculator/" class="text-sm accent-text font-semibold hover:opacity-80 transition-opacity shrink-0 whitespace-nowrap">Weight Calculator →</a>
    </div>

    <div class="prose max-w-none text-theme-secondary leading-relaxed space-y-8">

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Galvanizing Process</h2>
        <p>Hot-dip galvanizing immerses fully fabricated steel grating panels in molten zinc (at approximately 450°C). The zinc metallurgically bonds to the steel surface, forming a layered structure that is harder than pure zinc and far more durable than zinc spray coatings or paint systems.</p>
        <div class="grid md:grid-cols-3 gap-3 mt-4">
          {[
            { label: "Zinc coating thickness", value: "45–85 μm (ISO 1461)" },
            { label: "Weight increase", value: "~4% over bare steel" },
            { label: "Service life", value: "25–40 years outdoor" },
          ].map(({ label, value }) => (
            <div class="bg-theme-tertiary rounded-lg p-4 border border-theme text-center">
              <div class="text-xs text-theme-muted font-medium uppercase tracking-wide mb-1">{label}</div>
              <div class="font-semibold text-theme-primary accent-text">{value}</div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Applicable Standards</h2>
        <div class="overflow-x-auto mt-3">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-theme"><th class="text-left py-2 pr-4 text-theme-muted font-medium">Standard</th><th class="text-left py-2 text-theme-muted font-medium">Scope & Key Requirement</th></tr></thead>
            <tbody class="text-theme-secondary">
              {[
                ["ISO 1461 / EN ISO 1461", "International. Minimum average coating 45 μm for sections < 3mm; 55 μm for 3–6mm; 70 μm for > 6mm."],
                ["ASTM A123", "North American. Similar requirements; coating grade per steel thickness and piece thickness."],
                ["GB/T 13912-2002", "Chinese standard (equivalent to ISO 1461). Used for all Anping exports. Test method includes acid strip test."],
                ["AS/NZS 4680", "Australia/New Zealand. 45–85 μm same as ISO 1461; commonly specified for offshore oil & gas projects."],
              ].map(([std, scope]) => (
                <tr class="border-b border-theme/50">
                  <td class="py-2 pr-4 font-mono text-sm font-medium text-theme-primary whitespace-nowrap">{std}</td>
                  <td class="py-2">{scope}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Applications</h2>
        <ul class="grid md:grid-cols-2 gap-2 mt-3 text-sm">
          {[
            "Coastal and marine structures", "Outdoor industrial platforms",
            "Water treatment plants", "Bridge and highway maintenance walkways",
            "Agricultural and livestock facilities", "Chemical plant exteriors",
            "Port and harbour access walkways", "Municipal drainage covers"
          ].map(app => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full accent-bg shrink-0"></span>
              <span class="text-theme-secondary">{app}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-theme-primary">Ordering Notes</h2>
        <ul class="list-disc pl-6 space-y-2 text-sm mt-2">
          <li>Specify <strong class="text-theme-primary">pre-galvanizing cut</strong> — all dimensions must be final before zinc bath</li>
          <li>Pre-drilled holes, stair nosing plates, and kick plates can all be galvanized in-assembly</li>
          <li>Request mill certificate (material grade) and galvanizing certificate (coating weight per m²) for critical projects</li>
          <li>Add 4% to bare steel weight for sea freight volume/weight calculations</li>
        </ul>
      </section>

    </div>

    <FaqJsonLd items={faqs.map(([q, a]) => ({ question: q, answer: a }))} inLanguage="en" />
    <div class="mt-10 pt-8 border-t border-theme">
      <h2 class="text-xl font-semibold text-theme-primary mb-5">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map(([q, a]) => (
          <details class="card group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium text-theme-primary">{q}</span>
              <svg class="w-5 h-5 text-theme-muted shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-sm text-theme-secondary leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-theme">
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/products/plain-steel-grating/" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">Product</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">Plain Steel Grating</h3>
        </a>
        <a href="/products/stainless-steel-grating/" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">Product</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">Stainless Steel Grating</h3>
        </a>
        <a href="/inquiry/?product=galvanized-grating" class="card card-accent group">
          <span class="text-xs font-mono accent-text uppercase tracking-wider">Get Quote</span>
          <h3 class="font-semibold text-theme-primary group-hover:text-theme-secondary transition-colors mt-1">Request Galvanized Grating</h3>
        </a>
      </div>
    </div>

  </article>

</Base>
